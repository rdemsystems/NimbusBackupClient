<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared installer body. Included by a brand entry file (see Product.wxs /
     NimbusBackup.wxs / AcmeBackup.wxs) that supplies the brand identity via
     !define BEFORE the include. All identity is driven by these preprocessor variables:
       ProductName, ExeName, ServiceExeName, VendorKey, Manufacturer,
       UpgradeCode, ProductVersion, ArpUrlAbout, ArpHelpLink,
       ArpUrlUpdateInfo, ArpContact.
     The exe is installed under the SAME name as the installer (ExeName); the
     GUI resolves its brand from the exe base name at runtime (gui/brand.go),
     so the installed exe name == installer name == brand key. -->
<!-- WiX 3 requires an included file to have an Include root element. -->
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="$(var.ProductName) - Proxmox Backup Server Client"
             Comments="Backup client with automatic scheduling and VSS support" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      Schedule="afterInstallInitialize"
      AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Application icon, selected from installer/icons/ by the ExeName -->
    <Icon Id="AppIcon.ico" SourceFile="../icons/$(var.ExeName).ico" />
    <!-- Programs & Features icon. WiX 3 has no Product/@Icon attribute
         (candle rejects it); ARPPRODUCTICON is the supported way. -->
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Installation directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="$(var.ExeName)" />
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)"/>
      </Directory>
    </Directory>

    <!-- Main application files -->
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- GUI Executable (installed under the installer/ExeName) -->
      <Component Id="GUIExecutable" Guid="*" Win64="yes">
        <File Id="GuiExe"
              Source="../../gui/build/bin/$(var.ExeName).exe"
              KeyPath="yes" />
      </Component>

      <!-- Service Executable (shares the ExeName base with a "SVC" suffix) -->
      <Component Id="ServiceExecutable" Guid="*" Win64="yes">
        <File Id="SvcExe"
              Source="../../gui/build/bin/$(var.ServiceExeName).exe"
              KeyPath="yes" />

        <!-- Service installation. The SCM name is the brand's ExeName (e.g.
             "NimbusBackup"), NOT the service exe name: it is the name every
             Nimbus MSI up to 0.3.0 registered (scripts/monitoring target it),
             and gui/service_name.go derives the same name from the running
             <ServiceExeName>.exe by stripping its "SVC" suffix. -->
        <ServiceInstall
          Id="BackupService"
          Type="ownProcess"
          Name="$(var.ExeName)"
          DisplayName="$(var.ProductName) Service"
          Description="Executes scheduled backups to Proxmox Backup Server with VSS support"
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Interactive="no">
          <ServiceDependency Id="RPCSS"/>
        </ServiceInstall>

        <ServiceControl
          Id="ControlBackupService"
          Name="$(var.ExeName)"
          Start="install"
          Stop="both"
          Wait="yes"
          Remove="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="Backup client for Proxmox Backup Server"
                  Icon="AppIcon.ico"
                  Target="[INSTALLFOLDER]$(var.ExeName).exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.VendorKey)\$(var.ExeName)"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>

      <!-- Auto-start registry entry (conditional) -->
      <Component Id="AutoStartRegistry" Guid="*">
        <Condition>AUTOSTART = "1"</Condition>
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="$(var.ExeName)"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]$(var.ExeName).exe&quot; --minimized"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Features -->
    <Feature Id="ProductFeature"
             Title="$(var.ProductName)"
             Level="1"
             Description="Complete backup solution with automatic scheduling">
      <ComponentRef Id="GUIExecutable" />
      <ComponentRef Id="ServiceExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="AutoStartRegistry" />
    </Feature>

    <!-- Add/Remove Programs metadata (Programs & Features). Per-brand; keep in
         sync with the brand's Urls map in gui/brand.go. -->
    <Property Id="ARPURLINFOABOUT" Value="$(var.ArpUrlAbout)" />
    <Property Id="ARPHELPLINK" Value="$(var.ArpHelpLink)" />
    <Property Id="ARPURLUPDATEINFO" Value="$(var.ArpUrlUpdateInfo)" />
    <Property Id="ARPCONTACT" Value="$(var.ArpContact)" />

    <!-- UI -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- License -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ==================== AUTO-START CONFIGURATION ==================== -->
    <Property Id="AUTOSTART" Value="1" />

    <!-- ==================== UNINSTALL CONFIGURATION CLEANUP ==================== -->
    <Property Id="KEEP_CONFIG" Value="1" />

    <CustomAction Id="SetKeepConfigNo" Property="KEEP_CONFIG" Value="0" />
    <CustomAction Id="SetKeepConfigYes" Property="KEEP_CONFIG" Value="1" />

    <!-- Custom action to kill all GUI processes before upgrade -->
    <CustomAction Id="KillGUIProcesses"
                  Directory="TARGETDIR"
                  ExeCommand='cmd.exe /c "taskkill /F /IM $(var.ExeName).exe /T 2&gt;nul || exit 0"'
                  Execute="immediate"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Custom action to delete config directory. The data directory is
         brand-independent (gui/config.go getConfigDir: ProgramData\ProxmoxBackupClient);
         ProgramData\NimbusBackup is the pre-0.3 folder that
         gui/legacy_datadir.go copies from and deliberately leaves behind. -->
    <CustomAction Id="DeleteConfigFolder"
                  Directory="TARGETDIR"
                  ExeCommand='cmd.exe /c "(if exist "%ProgramData%\ProxmoxBackupClient" rmdir /s /q "%ProgramData%\ProxmoxBackupClient") &amp; (if exist "%ProgramData%\NimbusBackup" rmdir /s /q "%ProgramData%\NimbusBackup")"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Schedule custom actions -->
    <InstallExecuteSequence>
      <Custom Action="KillGUIProcesses" Before="StopServices">
        UPGRADINGPRODUCTCODE
      </Custom>
      <Custom Action="DeleteConfigFolder" Before="RemoveFiles">
        (REMOVE="ALL") AND NOT UPGRADINGPRODUCTCODE AND (KEEP_CONFIG="0")
      </Custom>
    </InstallExecuteSequence>

    <!-- Custom dialogs (WiX UI extension) -->
    <UI>
      <Dialog Id="UninstallDlg" Width="370" Height="270" Title="[ProductName] - Uninstall">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Uninstall [ProductName]</Text>
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>Do you want to keep your configuration and logs?</Text>
        </Control>

        <Control Id="ConfigInfo" Type="Text" X="25" Y="60" Width="320" Height="60" Transparent="yes" NoPrefix="yes">
          <Text>The configuration is stored in:\nC:\ProgramData\ProxmoxBackupClient\

This includes:
• config.json (PBS servers, credentials)
• scheduled_jobs.json and job_history.json (scheduled jobs)
• the GUI and service logs (*-gui.log, *-service.log)
          </Text>
        </Control>

        <Control Id="KeepConfigRadio" Type="RadioButtonGroup" X="25" Y="130" Width="320" Height="50" Property="KEEP_CONFIG">
          <RadioButtonGroup Property="KEEP_CONFIG">
            <RadioButton Text="Keep configuration" Value="1" X="0" Y="0" Width="300" Height="15" />
            <RadioButton Text="Delete configuration" Value="0" X="0" Y="20" Width="300" Height="15" />
          </RadioButtonGroup>
        </Control>

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
        </Control>

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Uninstall">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>

        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="UninstallDlg" Before="ProgressDlg">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Show>
      </InstallUISequence>
    </UI>

  </Product>
</Include>
