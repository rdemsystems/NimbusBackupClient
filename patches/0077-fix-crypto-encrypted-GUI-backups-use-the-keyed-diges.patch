diff --git a/pbscommon/didx_reader.go b/pbscommon/didx_reader.go
index 202de4d..30a1308 100644
--- a/pbscommon/didx_reader.go
+++ b/pbscommon/didx_reader.go
@@ -2,6 +2,8 @@ package pbscommon
 
 import (
 	"container/list"
+	"crypto/sha256"
+	"encoding/hex"
 	"errors"
 	"fmt"
 	"io"
@@ -98,7 +100,7 @@ func (r *DIDXReaderAt) chunkAt(ci int) ([]byte, error) {
 	// id_key-salted digest for an encrypted snapshot (see PBSClient.ChunkDigest).
 	// A mismatch means a corrupted or tampered chunk — fail rather than serve
 	// wrong data.
-	if r.pbs.ChunkDigestHex(chunk) != digest {
+	if r.pbs.ChunkDigestHex(chunk) != digest && !legacyEncryptedDigest(r.pbs, chunk, digest) {
 		return nil, fmt.Errorf("chunk %s (index %d): content hash mismatch", digest, ci)
 	}
 	r.cache.put(ci, chunk)
@@ -198,3 +200,18 @@ func (c *chunkCache) put(idx int, data []byte) {
 		delete(c.items, oldest.Value.(*chunkCacheEntry).idx)
 	}
 }
+
+// legacyEncryptedDigest accepts an encrypted snapshot's chunk indexed under the
+// bare sha256(plaintext) instead of sha256(plaintext || id_key). The GUI and
+// service directory backup of 0.4.1 and 0.4.2 wrote such snapshots
+// (rdemsystems/NimbusBackupClient#13); without this they could not be restored
+// at all. Accepting it keeps the check meaningful: the bare sha256 still binds
+// the chunk to the index, and an encrypted chunk has also passed AES-GCM
+// authentication under the key on its way here.
+func legacyEncryptedDigest(pbs *PBSClient, chunk []byte, digest string) bool {
+	if pbs.Crypt == nil {
+		return false
+	}
+	sum := sha256.Sum256(chunk)
+	return hex.EncodeToString(sum[:]) == digest
+}
diff --git a/pbscommon/didx_reader_test.go b/pbscommon/didx_reader_test.go
index a0a76b1..c47bba0 100644
--- a/pbscommon/didx_reader_test.go
+++ b/pbscommon/didx_reader_test.go
@@ -454,6 +454,47 @@ func TestDIDXReaderAtEncryptedArchive(t *testing.T) {
 	}
 }
 
+// The GUI/service directory backup of 0.4.1 and 0.4.2 encrypted its chunks but
+// indexed them under the bare SHA-256 (rdemsystems/NimbusBackupClient#13). Such
+// snapshots must stay restorable with the key.
+func TestDIDXReaderAtLegacyEncryptedArchive(t *testing.T) {
+	crypt := testCryptConfig(t)
+	payloads := payloadsOf(3, 128)
+	a := makeDIDX(t, nil, payloads...) // bare SHA-256 digests...
+	want := bytes.Join(payloads, nil)
+
+	f := newFakePBSWithDIDX(t, "legacy.didx", a, crypt) // ...over encrypted blobs
+	r, _, err := f.NewDIDXReaderAt("legacy.didx", 8, nil)
+	if err != nil {
+		t.Fatalf("NewDIDXReaderAt: %v", err)
+	}
+	got := make([]byte, len(want))
+	if _, err := r.ReadAt(got, 0); err != nil && !errors.Is(err, io.EOF) {
+		t.Fatalf("ReadAt: %v", err)
+	}
+	if !bytes.Equal(got, want) {
+		t.Error("decrypted stream differs from the original chunks")
+	}
+}
+
+// The legacy fallback must not turn the integrity check off.
+func TestDIDXReaderAtLegacyEncryptedArchiveRejectsMismatch(t *testing.T) {
+	crypt := testCryptConfig(t)
+	payloads := payloadsOf(2, 64)
+	a := makeDIDX(t, nil, payloads...)
+	f := newFakePBSWithDIDX(t, "legacy.didx", a, crypt)
+	f.corrupt[a.order[0]] = bytes.Repeat([]byte{0xAB}, len(payloads[0]))
+
+	r, _, err := f.NewDIDXReaderAt("legacy.didx", 4, nil)
+	if err != nil {
+		t.Fatalf("NewDIDXReaderAt: %v", err)
+	}
+	_, err = r.ReadAt(make([]byte, 8), 0)
+	if err == nil || !strings.Contains(err.Error(), "content hash mismatch") {
+		t.Errorf("error = %v, want a content hash mismatch", err)
+	}
+}
+
 // Without the key, an encrypted archive must fail loudly rather than serve
 // ciphertext.
 func TestDIDXReaderAtEncryptedArchiveWithoutKey(t *testing.T) {
