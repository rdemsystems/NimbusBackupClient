new file mode 100644
index 0000000..f668231
--- /dev/null
+++ b/.github/workflows/stars.yml
@@ -0,0 +1,54 @@
+name: Stars
+
+# Logs the GitHub stars of Nimbus Backup, upstream and the starred forks every
+# day, and redraws the charts the README shows (.github/scripts/stars.py).
+# Everything it writes lives on the `stats` branch, so the log never adds
+# commits to master nor starts a build.
+on:
+  schedule:
+    - cron: '17 5 * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+concurrency:
+  group: stars
+  cancel-in-progress: false
+
+jobs:
+  stars:
+    name: Log stars and draw the charts
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v5
+
+      - name: Check out the stats branch
+        run: |
+          if git ls-remote --exit-code --heads origin stats >/dev/null; then
+            git fetch --depth=1 origin stats
+            git worktree add stats-out FETCH_HEAD
+          else
+            git worktree add --detach stats-out
+            git -C stats-out checkout --orphan stats
+            git -C stats-out rm -rq --cached .
+            git -C stats-out clean -fdqx
+          fi
+
+      - name: Log and draw
+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+        run: python3 .github/scripts/stars.py stats-out
+
+      - name: Commit to the stats branch
+        working-directory: stats-out
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add stars.csv stars.svg stars-compare.svg
+          if git diff --cached --quiet; then
+            echo "Nothing changed"
+            exit 0
+          fi
+          git commit -q -m "stars: $(date -u +%Y-%m-%d)"
+          git push origin HEAD:refs/heads/stats
