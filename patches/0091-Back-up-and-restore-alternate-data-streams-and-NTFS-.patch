+				t.Errorf("%s: read-only attribute not restored", label)
+				bad++
+			}
+		}
+		t.Logf("%s: %d paths checked, %d streams and %d EAs restored, %d problems", label, len(expect), nStreams, nEAs, bad)
+	})
