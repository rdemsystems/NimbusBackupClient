From 55d845b50f71538d2d6de252cad76eb936a23b5f Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Tue, 20 Oct 2026 16:37:06 +0200
Subject: [PATCH 080/120] Revert "fix(restore): restore directory modification
 times (issue #12)"

This reverts commit 893d8cf: upstream fa06835 (next commit) fixes the
same bug more completely (times at or before 1970, ancestors of a
selective restore, existing folders without overwrite).
---
 pbscommon/pxar_reader.go      | 17 -----------------
 pbscommon/pxar_reader_test.go | 19 -------------------
 2 files changed, 36 deletions(-)

diff --git a/pbscommon/pxar_reader.go b/pbscommon/pxar_reader.go
index ecbc50b..65ddec6 100644
--- a/pbscommon/pxar_reader.go
+++ b/pbscommon/pxar_reader.go
@@ -471,26 +471,9 @@ func (pr *PXARReader) ExtractWithRewriter(rewriter PathRewriter, includePaths []
 		})
 		return nil
 	})
-	restoreDirTimes(extracted)
 	return extracted, err
 }
 
-// restoreDirTimes sets each extracted directory's mtime once nothing more is
-// written into it: creating a child bumps its parent's mtime, so doing it at
-// mkdir time left every directory at the restore time
-// (rdemsystems/NimbusBackupClient#12). The walk is depth-first pre-order, so
-// going backwards handles children before their parents.
-func restoreDirTimes(extracted []PXARExtractedFile) {
-	for i := len(extracted) - 1; i >= 0; i-- {
-		f := extracted[i]
-		if !f.IsDir || f.Skipped || f.ModTime <= 0 {
-			continue
-		}
-		t := time.Unix(f.ModTime, 0)
-		_ = os.Chtimes(f.Path, t, t)
-	}
-}
-
 // isUnsafeArchivePath reports whether a PXAR entry path could escape the restore
 // destination (zip-slip). Archive paths are normalised forward-slash relative
 // paths; anything absolute (unix root, UNC \\server), a Windows drive (C:/...),
diff --git a/pbscommon/pxar_reader_test.go b/pbscommon/pxar_reader_test.go
index ae5ea2c..2ae9ade 100644
--- a/pbscommon/pxar_reader_test.go
+++ b/pbscommon/pxar_reader_test.go
@@ -372,25 +372,6 @@ func TestPXARExtractAllPreservesModTime(t *testing.T) {
 	}
 }
 
-// Directories get their archived mtime back too, including ones that had files
-// written into them after they were created (rdemsystems/NimbusBackupClient#12).
-func TestPXARExtractAllPreservesDirModTime(t *testing.T) {
-	dest := t.TempDir()
-	if _, err := NewPXARReader(standardPXAR(t)).ExtractAll(dest); err != nil {
-		t.Fatalf("ExtractAll: %v", err)
-	}
-	want := time.Unix(1600000000, 0)
-	for _, d := range []string{"empty-dir", "sub", "sub/nested", "notes"} {
-		info, err := os.Stat(filepath.Join(dest, filepath.FromSlash(d)))
-		if err != nil {
-			t.Fatal(err)
-		}
-		if !info.ModTime().Equal(want) {
-			t.Errorf("%s mtime = %v, want %v", d, info.ModTime(), want)
-		}
-	}
-}
-
 func TestPXARExtractFilteredSelectsSubtree(t *testing.T) {
 	dest := t.TempDir()
 	got, err := NewPXARReader(standardPXAR(t)).ExtractFiltered(dest, []string{"/sub/"}, false)
