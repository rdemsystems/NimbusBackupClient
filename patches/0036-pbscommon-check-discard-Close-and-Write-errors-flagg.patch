Subject: [PATCH 36/49] pbscommon: check (discard) Close and Write errors
 flagged by errcheck

---
 pbscommon/didx_fixtures_test.go |  6 +++---
 pbscommon/pbsapi.go             | 30 +++++++++++++++---------------
 pbscommon/pxar.go               |  2 +-
 3 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/pbscommon/didx_fixtures_test.go b/pbscommon/didx_fixtures_test.go
index d12419e..0ca7815 100644
--- a/pbscommon/didx_fixtures_test.go
+++ b/pbscommon/didx_fixtures_test.go
@@ -108,10 +108,10 @@ func newFakePBSWithDIDX(t *testing.T, name string, a *didxArchive, crypt *CryptC
 				return
 			}
 			if f.overrideDidx != nil {
-				w.Write(f.overrideDidx)
+				_, _ = w.Write(f.overrideDidx)
 				return
 			}
-			w.Write(a.didx)
+			_, _ = w.Write(a.didx)
 		case "/chunk":
 			d := r.URL.Query().Get("digest")
 			f.mu.Lock()
@@ -125,7 +125,7 @@ func newFakePBSWithDIDX(t *testing.T, name string, a *didxArchive, crypt *CryptC
 			if repl, ok := f.corrupt[d]; ok {
 				payload = repl
 			}
-			w.Write(mustEncodeBlob(t, payload, crypt))
+			_, _ = w.Write(mustEncodeBlob(t, payload, crypt))
 		default:
 			http.Error(w, "unexpected path "+r.URL.Path, http.StatusNotFound)
 		}
