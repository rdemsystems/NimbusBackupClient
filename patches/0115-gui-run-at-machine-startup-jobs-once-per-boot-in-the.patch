+++ b/gui/main.go
@@ -341,9 +341,9 @@ func (a *App) startup(ctx context.Context) {
 		writeDebugLog("Service mode - scheduler runs in service")
 	}
 
-	// Execute startup jobs (jobs with runAtStartup=true)
