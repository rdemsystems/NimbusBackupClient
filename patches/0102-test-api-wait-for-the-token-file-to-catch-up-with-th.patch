From 4beb4be667f429b0d2764b4314f6994ed394bd1d Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Tue, 20 Oct 2026 17:32:42 +0200
Subject: [PATCH 102/120] test(api): wait for the token file to catch up with
 the rotated token

Rotate installs the new token on the server first and rewrites the file
right after (the previous token stays accepted meanwhile).
TestTokenRotatorRotatesOnInterval read the file the instant it saw the
new token, sometimes mid-rewrite, and failed with an empty file (seen on
the Go 1.26.9 run). It now waits for the file to match the token the
server enforces, accepting a later rotation. The write stays in place,
not temp file + rename: a replaced file would lose the explicit DACL the
Windows service sets on the token.
---
 gui/api/token_rotate_test.go | 29 +++++++++++++++++++++++------
 1 file changed, 23 insertions(+), 6 deletions(-)

diff --git a/gui/api/token_rotate_test.go b/gui/api/token_rotate_test.go
index 605ec48..8eceb74 100644
--- a/gui/api/token_rotate_test.go
+++ b/gui/api/token_rotate_test.go
@@ -275,12 +275,29 @@ func TestTokenRotatorRotatesOnInterval(t *testing.T) {
 		t.Fatal("rotator never replaced the token")
 	}
 
-	// The file must always carry the token the server is enforcing, or the
-	// next GUI to fetch it would authenticate with a dead secret.
-	if b, err := os.ReadFile(path); err != nil {
-		t.Fatalf("read token file: %v", err)
-	} else if strings.TrimSpace(string(b)) != rotated {
-		t.Errorf("file holds %q, server enforces %q", strings.TrimSpace(string(b)), rotated)
+	// The file must carry the token the server is enforcing, or the next GUI
+	// to fetch it would authenticate with a dead secret. Rotate installs the
+	// token on the server first and writes the file right after (the previous
+	// token stays accepted meanwhile), so the file may still be mid-write the
+	// instant the new token is seen: wait for it, briefly.
+	var inFile string
+	for {
+		b, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatalf("read token file: %v", err)
+		}
+		inFile = strings.TrimSpace(string(b))
+		if cur := currentToken(s); inFile == cur {
+			rotated = cur // a later rotation may have run meanwhile
+			break
+		}
+		if time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if inFile != rotated {
+		t.Errorf("file holds %q, server enforces %q", inFile, rotated)
 	}
 	st, err := os.Stat(path)
 	if err != nil {
