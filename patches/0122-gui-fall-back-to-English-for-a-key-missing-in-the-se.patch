From 4798536c5260d003eda3d7f6a0ed3ccf21957c59 Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Thu, 22 Oct 2026 07:46:24 +0200
Subject: [PATCH 122/123] gui: fall back to English for a key missing in the
 selected language

Until now t() showed the raw key (e.g. noRunningJobs) when the selected
language had no entry for it. It now looks the key up in English first,
and shows the raw key only when English has none either.
---
 CHANGELOG.md                          |  3 +++
 gui/frontend/src/i18n/i18nContext.jsx | 19 ++++++++++++++-----
 2 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 68e3df5..ee64344 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -10,6 +10,9 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0
 ### Added
 - **Enable or disable a scheduled job** (issue #17, suggested by [Tácio Andrade](https://github.com/Tacioandrade)): a "Job enabled" checkbox in the schedule form, between the daily time and "Also run at machine startup". A disabled job is kept but does not run, neither at its time nor at startup, until it is enabled again; it is shown greyed out with a "Disabled" badge in the job list. "Run now" still runs it on demand. A job created through the local HTTP API without an `enabled` key is still enabled, and an update without the key keeps the stored state.
 
+### Changed
+- **A text not translated yet in the selected language is shown in English** instead of its raw key.
+
 ## [0.4.4] - 2026-10-21
 
 ### Added
diff --git a/gui/frontend/src/i18n/i18nContext.jsx b/gui/frontend/src/i18n/i18nContext.jsx
index ad98234..c6dee81 100644
--- a/gui/frontend/src/i18n/i18nContext.jsx
+++ b/gui/frontend/src/i18n/i18nContext.jsx
@@ -29,17 +29,26 @@ export function I18nProvider({ children }) {
     localStorage.setItem('language', language)
   }, [language])
 
-  const t = (key, params) => {
-    const keys = key.split('.')
-    let value = translations[language]
-
+  const lookup = (lang, keys) => {
+    let value = translations[lang]
     for (const k of keys) {
       if (value && typeof value === 'object') {
         value = value[k]
       } else {
-        return key // Return key if translation not found
+        return undefined
       }
     }
+    return value
+  }
+
+  const t = (key, params) => {
+    const keys = key.split('.')
+    let value = lookup(language, keys)
+    // A key not translated yet in this language falls back to English
+    // before showing the raw key.
+    if (typeof value !== 'string' && language !== 'en') {
+      value = lookup('en', keys)
+    }
 
     if (typeof value === 'string' && params) {
       for (const [p, v] of Object.entries(params)) {
