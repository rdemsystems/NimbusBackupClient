From a8570e553f32f36639a69e67d79fa46dfdf27359 Mon Sep 17 00:00:00 2001
From: Tiziano Bacocco <tizbac2@gmail.com>
Date: Mon, 12 Oct 2026 13:38:40 +0200
Subject: [PATCH 73/75] gui: commit wails-generated SetJobReporter bindings

The wailsjs/go/main bindings for App.SetJobReporter (added in 44969cf)
were regenerated by the wails tooling but left uncommitted. Also drops
accidental exec-bit churn on wailsjs/runtime files.

Upstream: tizbac/proxmoxbackupclient_go@07859b051df68058cdb9b3f09e172555ce4aafa8
---
 gui/frontend/wailsjs/go/main/App.d.ts | 2 ++
 gui/frontend/wailsjs/go/main/App.js   | 4 ++++
 2 files changed, 6 insertions(+)

diff --git a/gui/frontend/wailsjs/go/main/App.d.ts b/gui/frontend/wailsjs/go/main/App.d.ts
index d299a15..7b3980c 100755
--- a/gui/frontend/wailsjs/go/main/App.d.ts
+++ b/gui/frontend/wailsjs/go/main/App.d.ts
@@ -126,6 +126,8 @@ export function SetBackupContext(arg1:context.Context,arg2:context.CancelFunc):P
 
 export function SetDefaultPBSServer(arg1:string):Promise<void>;
 
+export function SetJobReporter(arg1:main.JobReporter):Promise<void>;
+
 export function SetProgressCallbacks(arg1:string,arg2:any,arg3:any):Promise<void>;
 
 export function SetupSystemTray():Promise<void>;
diff --git a/gui/frontend/wailsjs/go/main/App.js b/gui/frontend/wailsjs/go/main/App.js
index 682d4b2..476db80 100755
--- a/gui/frontend/wailsjs/go/main/App.js
+++ b/gui/frontend/wailsjs/go/main/App.js
@@ -246,6 +246,10 @@ export function SetDefaultPBSServer(arg1) {
   return window['go']['main']['App']['SetDefaultPBSServer'](arg1);
 }
 
+export function SetJobReporter(arg1) {
+  return window['go']['main']['App']['SetJobReporter'](arg1);
+}
+
 export function SetProgressCallbacks(arg1, arg2, arg3) {
   return window['go']['main']['App']['SetProgressCallbacks'](arg1, arg2, arg3);
 }
-- 
