From 5c6fc6654c51518ea6769f9714fc516e23c4cbba Mon Sep 17 00:00:00 2001
From: mjb-is <mjb-is@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:36:53 +0100
Subject: [PATCH 094/108] BMR wizard: never offer the boot stick as the restore
 target

The target disk detection skipped removable, loop, optical and NBD
devices, and took the target without asking when exactly one disk was
left. A USB SSD (and many USB sticks) reports removable=0, and a Ventoy
stick serves the ISO through device-mapper, so the boot stick passed
those checks. On a machine whose own disk was not detected (missing
driver, disk disabled in the firmware), the stick was the one candidate
and was chosen without a question; on a machine with one internal disk
the stick turned the automatic choice into a menu.

The wizard now finds the disk(s) under the live medium from the mount's
MAJ:MIN through sysfs (/sys/dev/block/MAJ:MIN): device-mapper slaves are
followed down and a partition gives its disk. Names in /dev are not
used, because under Ventoy the medium is mounted from /dev/mapper/ventoy
but udev never creates that link in the live system (only /dev/dm-0
exists), and the VTOYEFI partition has no label in lsblk. A Ventoy stick
is also recognised by its device-mapper device named "ventoy", and by
VTOYEFI where udev does label it, so it is caught after a toram boot too.
Those disks, zram and dm-* devices are not candidates.

The boot disk is named in the target menu, the confirmation and the
no-target message ("Not eligible as target: /dev/sdb (250GB) boot disk
(Ventoy)"), so it is clear why it is not offered; the no-target message
also says to check that the machine's own disk is connected and enabled
in the firmware setup. Disk sizes come from one helper instead of three
copies of the parted pipeline.

Tested in a Proxmox VE VM booted from a 250 GB Ventoy stick passed
through over USB, with UEFI and with BIOS firmware, each in Ventoy's
normal and GRUB2 modes: every time the confirmation listed the stick as
not eligible and offered only the VM's own disk.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Upstream: tizbac/proxmoxbackupclient_go PR: #113 (mjb-is/proxmoxbackupclient_go@5d955dc5d3729d17472b068e265e7d7fd1e9a7ee)
---
 clonezilla-patch/ocs-pbs-bare-metal-restore | 73 ++++++++++++++++++---
 1 file changed, 64 insertions(+), 9 deletions(-)

diff --git a/clonezilla-patch/ocs-pbs-bare-metal-restore b/clonezilla-patch/ocs-pbs-bare-metal-restore
index 0a78640..c25f253 100644
--- a/clonezilla-patch/ocs-pbs-bare-metal-restore
+++ b/clonezilla-patch/ocs-pbs-bare-metal-restore
@@ -490,21 +490,76 @@ partx -a "$NBDDEV" >/dev/null 2>&1
 udevadm settle --timeout=10 >/dev/null 2>&1
 
 # 8. auto-detect the target disk: the one non-NBD, non-removable, non-loop,
-# non-optical local block device. Zero or more than one -> ask, never guess
-# on an ambiguous multi-disk machine (this is an irreversible drive-wipe).
+# non-optical local block device that is not the boot stick. Zero or more
+# than one -> ask, never guess on an ambiguous multi-disk machine (this is an
+# irreversible drive-wipe).
+#
+# The boot stick: a USB SSD often reports removable=0, and a Ventoy stick
+# serves the ISO through device-mapper, so neither is caught by the checks
+# above. Find the disk(s) under the live medium instead, from the mount's
+# MAJ:MIN through sysfs: device-mapper slaves are followed down and a
+# partition gives its disk. Names in /dev are not used, because under Ventoy
+# the medium is mounted from /dev/mapper/ventoy but udev never creates that
+# link in the live system (only /dev/dm-0 exists). A Ventoy stick is also
+# recognised by its device-mapper device named "ventoy" and by its VTOYEFI
+# partition, which still hold when the live system was copied to RAM (toram)
+# and the medium is no longer mounted.
+BOOT_DISKS=" "
+VENTOY_DISKS=" "
+add_boot_disk() { case "$BOOT_DISKS" in *" $1 "*) ;; *) BOOT_DISKS+="$1 " ;; esac; }
+disks_of_dev() {
+  local sys s
+  sys="$(readlink -f "/sys/dev/block/$1" 2>/dev/null)"
+  [ -n "$sys" ] && [ -e "$sys" ] || return 0
+  if [ -n "$(ls -A "$sys/slaves" 2>/dev/null)" ]; then
+    for s in "$sys"/slaves/*; do disks_of_dev "$(cat "$s/dev")"; done
+  elif [ -f "$sys/partition" ]; then
+    echo "/dev/$(basename "$(dirname "$sys")")"
+  else
+    echo "/dev/$(basename "$sys")"
+  fi
+}
+disk_size() { LC_ALL=C parted -s "$1" unit GB print 2>/dev/null | grep -m1 '^Disk .*:' | sed -E 's/.*: *//'; }
+for mm in $(findmnt -nro MAJ:MIN /run/live/medium 2>/dev/null); do
+  for d in $(disks_of_dev "$mm"); do add_boot_disk "$d"; done
+done
+for d in $(for dm in /sys/block/dm-*; do
+             [ "$(cat "$dm/dm/name" 2>/dev/null)" = "ventoy" ] && disks_of_dev "$(cat "$dm/dev")"
+           done) \
+         $(lsblk -nrpo NAME,PKNAME,LABEL 2>/dev/null | awk '$3=="VTOYEFI" && $2!=""{print $2}'); do
+  add_boot_disk "$d"
+  VENTOY_DISKS+="$d "
+done
+
+# The boot disk(s) are named in the dialogs below, so it is clear why the
+# stick is not offered: "Not eligible as target: /dev/sdb (0.5GB) boot disk".
+NOT_ELIGIBLE=""
+for d in $BOOT_DISKS; do
+  what="boot disk"
+  case "$VENTOY_DISKS" in *" $d "*) what="boot disk (Ventoy)" ;; esac
+  sz="$(disk_size "$d")"
+  NOT_ELIGIBLE+="\n  $d  (${sz:-unknown size})  $what"
+done
+NOT_ELIGIBLE_BLOCK=""
+if [ -n "$NOT_ELIGIBLE" ]; then
+  NOT_ELIGIBLE_BLOCK="\n\nNot eligible as target:$NOT_ELIGIBLE"
+  echo -e "Not eligible as target:$NOT_ELIGIBLE"
+fi
+
 declare -a CANDIDATES
 for bd in /sys/block/*; do
   name="$(basename "$bd")"
   case "$name" in
-    nbd*|loop*|sr*|ram*) continue ;;
+    nbd*|loop*|sr*|ram*|zram*|dm-*) continue ;;
   esac
   [ -f "$bd/removable" ] && [ "$(cat "$bd/removable" 2>/dev/null)" = "1" ] && continue
+  case "$BOOT_DISKS" in *" /dev/$name "*) continue ;; esac
   [ -b "/dev/$name" ] && CANDIDATES+=("/dev/$name")
 done
 
 if [ "${#CANDIDATES[@]}" -eq 0 ]; then
   $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
-  --msgbox "No local target disk found (only removable/optical/loop devices detected).\n\n$msg_program_stop" 0 0 $DIA_ESC
+  --msgbox "No local target disk found.${NOT_ELIGIBLE_BLOCK}\n\nCheck that the machine's own disk is connected and enabled in the firmware setup.\n\n$msg_program_stop" 0 0 $DIA_ESC
   exit 1
 elif [ "${#CANDIDATES[@]}" -eq 1 ]; then
   TARGET="${CANDIDATES[0]}"
@@ -512,12 +567,12 @@ else
   declare -a MENUT
   i=1
   for c in "${CANDIDATES[@]}"; do
-    sz="$(LC_ALL=C parted -s "$c" unit GB print 2>/dev/null | grep -m1 '^Disk .*:' | sed -E 's/.*: *//')"
+    sz="$(disk_size "$c")"
     MENUT+=("$i" "$c  (${sz:-unknown size})")
     i=$((i+1))
   done
   $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore" \
-  --menu "Multiple local disks found -- select the RESTORE TARGET (will be COMPLETELY OVERWRITTEN):" 0 0 15 \
+  --menu "Multiple local disks found -- select the RESTORE TARGET (will be COMPLETELY OVERWRITTEN):${NOT_ELIGIBLE_BLOCK}" 0 0 15 \
   "${MENUT[@]}" $DIA_ESC \
   2> "$DIA_TMP"
   CHOICET="$(cat "$DIA_TMP")"
@@ -529,8 +584,8 @@ else
 fi
 echo "Target disk        : $TARGET"
 
-SRC_SIZE="$(LC_ALL=C parted -s "$NBDDEV" unit GB print 2>/dev/null | grep -m1 '^Disk .*:' | sed -E 's/.*: *//')"
-TGT_SIZE="$(LC_ALL=C parted -s "$TARGET" unit GB print 2>/dev/null | grep -m1 '^Disk .*:' | sed -E 's/.*: *//')"
+SRC_SIZE="$(disk_size "$NBDDEV")"
+TGT_SIZE="$(disk_size "$TARGET")"
 
 # 9. confirmation before the destructive write: shows source+target+sizes.
 # Deliberately just the one dialog here, not also a typed device-name
@@ -541,7 +596,7 @@ TGT_SIZE="$(LC_ALL=C parted -s "$TARGET" unit GB print 2>/dev/null | grep -m1 '^
 # real timed run: this was the slowest manual step other than the
 # mandatory PBS server details.
 $DIA --backtitle "$msg_nchc_free_software_labs" --title "PBS Bare Metal Restore - CONFIRM" \
---yesno "Source (PBS snapshot) : ${NBDDEV}  (${SRC_SIZE:-unknown size})\nTarget (THIS MACHINE)  : ${TARGET}  (${TGT_SIZE:-unknown size})\n\nEVERYTHING on ${TARGET} will be PERMANENTLY OVERWRITTEN.\n\nContinue?" 0 0
+--yesno "Source (PBS snapshot) : ${NBDDEV}  (${SRC_SIZE:-unknown size})\nTarget (THIS MACHINE)  : ${TARGET}  (${TGT_SIZE:-unknown size})${NOT_ELIGIBLE_BLOCK}\n\nEVERYTHING on ${TARGET} will be PERMANENTLY OVERWRITTEN.\n\nContinue?" 0 0
 if [ "$?" != "0" ]; then
   echo "$msg_program_stop!"
   exit 1
-- 
