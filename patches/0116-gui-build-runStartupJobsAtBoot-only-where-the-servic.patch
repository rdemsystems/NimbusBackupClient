From d2a519d1f4729f34e152c327e12fae263d4f618f Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Wed, 21 Oct 2026 17:02:59 +0200
Subject: [PATCH 116/123] gui: build runStartupJobsAtBoot only where the
 service is built

The GUI-only Linux build never calls it, and the linter rejected it there
as unused.
---
 gui/scheduler.go    | 14 --------------
 gui/startup_jobs.go | 26 ++++++++++++++++++++++++++
 2 files changed, 26 insertions(+), 14 deletions(-)
 create mode 100644 gui/startup_jobs.go

diff --git a/gui/scheduler.go b/gui/scheduler.go
index e17205b..8b4c6fa 100644
--- a/gui/scheduler.go
+++ b/gui/scheduler.go
@@ -680,20 +680,6 @@ func isMachineStartup(uptime time.Duration, err error) bool {
 	return err != nil || uptime <= startupRunWindow
 }
 
-// runStartupJobsAtBoot runs the jobs set to run at machine startup, once per
-// boot. The service calls it when it starts, which is what "at machine
-// startup" means. The GUI used to run them each time it opened, which ran
-// the job again at every launch.
-func (a *App) runStartupJobsAtBoot() {
-	uptime, err := systemUptime()
-	if !isMachineStartup(uptime, err) {
-		writeDebugLog(fmt.Sprintf("Startup jobs not run: the machine has been up for %s, the service was restarted, not booted",
-			uptime.Round(time.Second)))
-		return
-	}
-	a.HandleStartupRun()
-}
-
 // HandleStartupRun executes scheduled jobs that have runAtStartup enabled.
 // Called through runStartupJobsAtBoot, in the service only.
 func (a *App) HandleStartupRun() {
diff --git a/gui/startup_jobs.go b/gui/startup_jobs.go
new file mode 100644
index 0000000..874c0f6
--- /dev/null
+++ b/gui/startup_jobs.go
@@ -0,0 +1,26 @@
+//go:build windows || service
+// +build windows service
+
+package main
+
+import (
+	"fmt"
+	"time"
+)
+
+// Only the service runs these jobs, so this lives in the files the service
+// is built from (every Windows build, and the service build elsewhere).
+
+// runStartupJobsAtBoot runs the jobs set to run at machine startup, once per
+// boot. The service calls it when it starts, which is what "at machine
+// startup" means. The GUI used to run them each time it opened, which ran
+// the job again at every launch.
+func (a *App) runStartupJobsAtBoot() {
+	uptime, err := systemUptime()
+	if !isMachineStartup(uptime, err) {
+		writeDebugLog(fmt.Sprintf("Startup jobs not run: the machine has been up for %s, the service was restarted, not booted",
+			uptime.Round(time.Second)))
+		return
+	}
+	a.HandleStartupRun()
+}
