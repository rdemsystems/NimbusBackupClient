From c160685a38ded0ba39b4d5e0a074f24546e5e74e Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Wed, 23 Sep 2026 10:04:13 +0200
Subject: [PATCH 06/46] gui, installer: keep the service name the MSI registers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The MSI registered the service under $(var.ServiceExeName) (e.g.
NimbusBackupSVC) while the Go side hard-coded "ProxmoxBackupClient", so
`<svc>.exe -service start|stop|uninstall` targeted a service that does not
exist, and upgraded Nimbus installs would also have lost the "NimbusBackup"
service name scripts and monitoring rely on.

Register the service under the brand's ExeName (NimbusBackup,
ProxmoxBackupClient — the latter is what upstream's Go code already used)
and derive the same name in Go from the running "<ExeName>SVC.exe" by
stripping the "SVC" suffix.
---
 gui/service_identity.go       | 28 +++++++++++++++-------------
 gui/service_identity_test.go  |  7 +++++--
 installer/wix/ProductBody.wxi | 10 +++++++---
 3 files changed, 27 insertions(+), 18 deletions(-)

diff --git a/gui/service_identity.go b/gui/service_identity.go
index 521eab7..6af765c 100644
--- a/gui/service_identity.go
+++ b/gui/service_identity.go
@@ -3,20 +3,22 @@ package main
 import "strings"
 
 // serviceIdentityForExeBase maps a service executable's base name (as the WiX
-// installer names it: $(var.ServiceExeName).exe) to the (SCM name, display
-// name) pair the service has to register under.
+// installer names it: $(var.ServiceExeName).exe, i.e. "<ExeName>SVC") to the
+// (SCM name, display name) pair the service has to register under.
 //
-// The SCM name is the executable base name verbatim, because
-// installer/wix/ProductBody.wxi registers the service as
-// Name="$(var.ServiceExeName)" and ships the binary as
-// $(var.ServiceExeName).exe. Registering anything else makes
-// StartServiceCtrlDispatcher fail with ERROR_FAILED_SERVICE_CONTROLLER_CONNECT
-// (1061) and Windows reports "service failed to start".
+// The SCM name is the brand's ExeName, the executable base name without its
+// "SVC" suffix, because installer/wix/ProductBody.wxi registers the service
+// as Name="$(var.ExeName)": that is the name every Nimbus Backup MSI up to
+// 0.3.0 registered ("NimbusBackup"), which scripts and monitoring target.
+// Registering anything else makes StartServiceCtrlDispatcher fail with
+// ERROR_FAILED_SERVICE_CONTROLLER_CONNECT (1061) and Windows reports "service
+// failed to start".
 //
-// The display name mirrors the installer's DisplayName="$(var.ProductName) Service",
-// resolving the brand from the exe base without the "SVC" suffix.
+// The display name mirrors the installer's DisplayName="$(var.ProductName) Service".
 func serviceIdentityForExeBase(exeBase string) (name, displayName string) {
-	name = exeBase
-	brandKey := strings.TrimSuffix(exeBase, "SVC")
-	return name, ResolveBrand(brandKey).Title + " Service"
+	name = strings.TrimSuffix(exeBase, "SVC")
+	if name == "" {
+		name = exeBase
+	}
+	return name, ResolveBrand(name).Title + " Service"
 }
diff --git a/gui/service_identity_test.go b/gui/service_identity_test.go
index e650251..ecf473e 100644
--- a/gui/service_identity_test.go
+++ b/gui/service_identity_test.go
@@ -52,12 +52,15 @@ func wixEntries(t *testing.T) map[string][2]string {
 
 func TestServiceNameMatchesWiXServiceInstall(t *testing.T) {
 	for file, entry := range wixEntries(t) {
+		// ProductBody.wxi registers the service as $(var.ExeName), which is
+		// ServiceExeName without its "SVC" suffix (see the test below).
 		serviceExeName := entry[0]
+		registered := strings.TrimSuffix(serviceExeName, "SVC")
 		name, _ := serviceIdentityForExeBase(serviceExeName)
-		if name != serviceExeName {
+		if name != registered {
 			t.Errorf("%s.wxs registers service %q but the binary would dispatch %q: "+
 				"SCM would reject the start with error 1061",
-				file, serviceExeName, name)
+				file, registered, name)
 		}
 	}
 }
diff --git a/installer/wix/ProductBody.wxi b/installer/wix/ProductBody.wxi
index e3a1d2f..aaa1f1e 100644
--- a/installer/wix/ProductBody.wxi
+++ b/installer/wix/ProductBody.wxi
@@ -50,11 +50,15 @@
               Source="../../gui/build/bin/$(var.ServiceExeName).exe"
               KeyPath="yes" />
 
-        <!-- Service installation -->
+        <!-- Service installation. The SCM name is the brand's ExeName (e.g.
+             "NimbusBackup"), NOT the service exe name: it is the name every
+             Nimbus MSI up to 0.3.0 registered (scripts/monitoring target it),
+             and gui/service_identity.go derives the same name from the running
+             $(var.ServiceExeName).exe by stripping its "SVC" suffix. -->
         <ServiceInstall
           Id="BackupService"
           Type="ownProcess"
-          Name="$(var.ServiceExeName)"
+          Name="$(var.ExeName)"
           DisplayName="$(var.ProductName) Service"
           Description="Executes scheduled backups to Proxmox Backup Server with VSS support"
           Start="auto"
@@ -66,7 +70,7 @@
 
         <ServiceControl
           Id="ControlBackupService"
-          Name="$(var.ServiceExeName)"
+          Name="$(var.ExeName)"
           Start="install"
           Stop="both"
           Wait="yes"
-- 
