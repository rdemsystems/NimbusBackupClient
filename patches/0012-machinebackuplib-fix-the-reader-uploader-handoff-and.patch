 gui/backup_inline.go              |   4 +-
 machinebackuplib/linux.go         |  17 +--
 machinebackuplib/machinebackup.go | 188 ++++++++++++++++++------------
 machinebackuplib/windows.go       |  17 +--
 4 files changed, 127 insertions(+), 99 deletions(-)

