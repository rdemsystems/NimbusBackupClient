diff --git a/pbscommon/didx_reader_test.go b/pbscommon/didx_reader_test.go
index c47bba0..b5bd805 100644
--- a/pbscommon/didx_reader_test.go
+++ b/pbscommon/didx_reader_test.go
@@ -513,6 +513,36 @@ func TestDIDXReaderAtEncryptedArchiveWithoutKey(t *testing.T) {
 	}
 }
 
+// An unencrypted archive (a snapshot taken before the key was set up) must
+// still read with the key loaded: its chunks carry plain sha256 digests.
+// Found live 2026-10-17: Undelete on a machine set failed with "content hash
+// mismatch" on its older, unencrypted snapshots once a key was configured.
+func TestDIDXReaderAtPlainArchiveWithKeyLoaded(t *testing.T) {
+	payloads := payloadsOf(3, 64)
+	a := makeDIDX(t, nil, payloads...)
+	f := newFakePBSWithDIDX(t, "plain.didx", a, nil)
+	f.Crypt = testCryptConfig(t)
+
+	r, size, err := f.NewDIDXReaderAt("plain.didx", 4, nil)
+	if err != nil {
+		t.Fatalf("NewDIDXReaderAt: %v", err)
+	}
+	got := make([]byte, size)
+	if _, err := r.ReadAt(got, 0); err != nil {
+		t.Fatalf("reading a plain archive with a key loaded: %v", err)
+	}
+	if !bytes.Equal(got, bytes.Join(payloads, nil)) {
+		t.Fatal("wrong content")
+	}
+
+	// A tampered chunk is still caught.
+	f.corrupt[a.order[1]] = bytes.Repeat([]byte{0xCD}, len(payloads[1]))
+	r2, _, _ := f.NewDIDXReaderAt("plain.didx", 4, nil)
+	if _, err := r2.ReadAt(make([]byte, 8), 64); err == nil {
+		t.Fatal("a tampered chunk was accepted with a key loaded")
+	}
+}
+
 // The wrong key must fail the integrity check, not silently return garbage.
 func TestDIDXReaderAtEncryptedArchiveWrongKey(t *testing.T) {
 	crypt := testCryptConfig(t)
diff --git a/pbscommon/pbsapi.go b/pbscommon/pbsapi.go
index 5fdc238..f4aaf1b 100644
--- a/pbscommon/pbsapi.go
+++ b/pbscommon/pbsapi.go
@@ -818,6 +818,22 @@ func (pbs *PBSClient) ChunkDigestHex(chunkdata []byte) string {
 	return hex.EncodeToString(sum[:])
 }
 
+// ChunkMatchesDigest reports whether a fetched chunk's plaintext is the one
+// digestHex names. With a key configured, a plain sha256 also matches: an
+// unencrypted snapshot (taken before the key was set up) read with the key
+// loaded. Choosing the right one per snapshot would need its manifest at
+// every reader; a match of the other kind would need a sha256 preimage.
+func (pbs *PBSClient) ChunkMatchesDigest(chunkdata []byte, digestHex string) bool {
+	if pbs.ChunkDigestHex(chunkdata) == digestHex {
+		return true
+	}
+	if pbs.Crypt == nil {
+		return false
+	}
+	sum := sha256.Sum256(chunkdata)
+	return hex.EncodeToString(sum[:]) == digestHex
+}
+
 // defaultCryptMode is the crypt-mode a freshly created index archive entry
 // gets. UploadManifest re-derives it for every archive before signing, so
 // this is only about keeping the in-memory manifest honest between creation
