+// parseQRSVG rasterizes the "M x yhWv1h-Wz" runs qrSVG writes.
+func parseQRSVG(t *testing.T, svg string, size, margin int) [][]bool {
+	t.Helper()
+	i := strings.Index(svg, ` d="`)
+	j := strings.LastIndex(svg, `"/>`)
+	if i < 0 || j < i {
+		t.Fatalf("no path in SVG: %s", svg)
+	}
+	grid := make([][]bool, size)
+	for y := range grid {
+		grid[y] = make([]bool, size)
+	}
+	for _, run := range strings.Split(strings.TrimSuffix(svg[i+4:j], "z"), "z") {
+		var x, y, w, w2 int
+		if _, err := fmt.Sscanf(run, "M%d %dh%dv1h-%d", &x, &y, &w, &w2); err != nil || w != w2 {
+			t.Fatalf("bad run %q: %v", run, err)
+		}
+		for k := 0; k < w; k++ {
+			grid[y-margin][x-margin+k] = true
+		}
+	}
+	return grid
+}
+
+func TestQRSVGMatchesCode(t *testing.T) {
+	kc, err := ParseKeyConfig([]byte(vecKeyfileScrypt))
+	if err != nil {
+		t.Fatal(err)
+	}
+	pk, err := NewPaperKey(kc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	code, err := qr.Encode(pk.JSON, qr.M)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if (code.Size-17)%4 != 0 || code.Size < 21 {
+		t.Fatalf("odd QR size %d", code.Size)
+	}
+	n := code.Size + 8
+	if !strings.Contains(pk.QRSVG, fmt.Sprintf(`viewBox="0 0 %d %d"`, n, n)) {
+		t.Errorf("viewBox does not include the 4-module quiet zone: %s", pk.QRSVG[:120])
+	}
+	grid := parseQRSVG(t, pk.QRSVG, code.Size, 4)
+	for y := 0; y < code.Size; y++ {
+		for x := 0; x < code.Size; x++ {
+			if grid[y][x] != code.Black(x, y) {
+				t.Fatalf("module (%d,%d) = %v, want %v", x, y, grid[y][x], code.Black(x, y))
+			}
+		}
+	}
+	// Top-left finder pattern: dark 7x7 ring, light ring, dark 3x3 core.
+	for k := 0; k < 7; k++ {
+		if !grid[0][k] || !grid[6][k] || !grid[k][0] || !grid[k][6] {
+			t.Fatalf("finder pattern ring broken at %d", k)
+		}
+	}
+	if grid[1][1] || !grid[3][3] {
+		t.Fatal("finder pattern core broken")
+	}
+}
