+// The text of a paper key, with or without what surrounds the markers, and
+// the QR payload must all import back to the same key.
+func TestPaperKeyImportsBack(t *testing.T) {
+	kc, err := ParseKeyConfig([]byte(vecKeyfileScrypt))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want, err := kc.CryptConfig([]byte(pkVecPassphrase))
+	if err != nil {
+		t.Fatal(err)
+	}
+	pk, err := NewPaperKey(kc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, in := range map[string]string{
+		"qr payload": pk.JSON,
+		"text":       pk.Text,
+		"pbs text":   "Subject: my key\n\n" + pk.Text + "\n█▀▀▀▀▀█ qr art\n",
+		"indented":   "  " + strings.ReplaceAll(pk.Text, "\n", "\r\n  "),
+		"no end":     paperKeyBegin + "\n" + pk.JSON,
+		"original":   vecKeyfileScrypt,
+	} {
+		got, err := ParseKeyConfig([]byte(in))
+		if err != nil {
+			t.Errorf("%s: %v", name, err)
+			continue
+		}
+		crypt, err := got.CryptConfig([]byte(pkVecPassphrase))
+		if err != nil {
+			t.Errorf("%s: %v", name, err)
+			continue
+		}
+		if crypt.Fingerprint() != want.Fingerprint() || want.Fingerprint() != pkVecFingerprint {
+			t.Errorf("%s: key mismatch", name)
+		}
+	}
+}
