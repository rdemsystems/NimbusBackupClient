+
+	"rsc.io/qr"
+)
+
+// Golden key files generated by OpenSSL's libcrypto (the library
+// proxmox-backup-client uses), protecting key 00 01 .. 1f with passphrase
+// pkVecPassphrase. The fingerprint matches proxmox-backup's own tests.
+const (
+	pkVecPassphrase  = "correct horse battery"
+	pkVecFingerprint = "0e:ab:d4:46:0b:6e:b9:ca:34:50:23:de:e2:b7:78:c7:90:e5:4a:16:83:b9:65:9c:0a:57:ae:19:90:90:15:9b"
+	vecKeyfileScrypt = `{"kdf": {"Scrypt": {"n": 65536, "r": 8, "p": 1, "salt": "yMnKy8zNzs/Q0dLT1NXW19jZ2tvc3d7f4OHi4+Tl5uc="}}, "created": "2026-09-30T12:00:00+02:00", "modified": "2026-09-30T12:00:00+02:00", "data": "MjM0NTY3ODk6Ozw9Pj9AQS9y+1ZDO3RKqC2a/i42IUQHHuvDc5i/5/oKFXwec3pch1cc2ZSAFjm2ruQbH6ZdWg==", "fingerprint": "0e:ab:d4:46:0b:6e:b9:ca:34:50:23:de:e2:b7:78:c7:90:e5:4a:16:83:b9:65:9c:0a:57:ae:19:90:90:15:9b", "hint": "test"}`
+)
+
+// testKeyConfig returns an unprotected key file for key {b, 0, 0, ...}.
+func testKeyConfig(t *testing.T, b byte, hint string) *KeyConfig {
+	t.Helper()
+	key := make([]byte, BlobEncryptionKeySize)
+	key[0] = b
+	crypt, err := NewCryptConfig(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &KeyConfig{
+		Created:     "2026-10-09T12:00:00Z",
+		Modified:    "2026-10-09T12:00:00Z",
+		Data:        base64.StdEncoding.EncodeToString(key),
+		Fingerprint: crypt.Fingerprint(),
+		Hint:        hint,
+	}
+}
