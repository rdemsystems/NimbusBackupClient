+func TestProtectKeyConfig(t *testing.T) {
+	plain, err := testKeyConfig(t, 5, "").CryptConfig(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ProtectKeyConfig(plain, []byte("abc"), ""); err == nil {
+		t.Error("short passphrase accepted")
+	}
+	kc, err := ProtectKeyConfig(plain, []byte("s3cret pass"), "the usual")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if kc.KDF == nil || kc.KDF.KDF != "scrypt" || kc.KDF.N != 65536 || kc.KDF.R != 8 || kc.KDF.P != 1 {
+		t.Fatalf("kdf = %+v", kc.KDF)
+	}
+	if _, err := kc.CryptConfig([]byte("wrong pass")); err == nil || !strings.Contains(err.Error(), "the usual") {
+		t.Errorf("wrong passphrase: err = %v", err)
+	}
+	// Through the paper key text, as it would be typed back.
+	pk, err := NewPaperKey(kc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(pk.JSON, `"Scrypt": {`) {
+		t.Errorf("protected paper key lacks the scrypt KDF:\n%s", pk.JSON)
+	}
+	back, err := ParseKeyConfig([]byte(pk.Text))
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := back.CryptConfig([]byte("s3cret pass"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Fingerprint() != plain.Fingerprint() {
+		t.Errorf("fingerprint %s, want %s", got.Fingerprint(), plain.Fingerprint())
+	}
+}
