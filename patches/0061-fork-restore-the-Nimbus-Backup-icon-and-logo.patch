From 8f410df6513916c4fa9509f5b98a526c076c92a5 Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Mon, 12 Oct 2026 14:34:39 +0200
Subject: [PATCH 061/108] fork: restore the Nimbus Backup icon and logo

The upstream rebuild brought back upstream's regenerated
gui/build/windows/icon.ico (an "f" glyph), so 0.4.1 shipped with a
foreign window/taskbar icon, and the About tab showed the placeholder
nimbus.svg instead of the real logo.

- gui/build/windows/icon.ico: the Nimbus icon shipped up to 0.4.0
- brands/nimbus.webp: the real Nimbus logo, replacing the placeholder SVG
---
 gui/brand.go                           |   2 +-
 gui/build/windows/icon.ico             | Bin 2689 -> 141566 bytes
 gui/frontend/public/brands/nimbus.svg  |   5 -----
 gui/frontend/public/brands/nimbus.webp | Bin 0 -> 6814 bytes
 4 files changed, 1 insertion(+), 6 deletions(-)
 delete mode 100644 gui/frontend/public/brands/nimbus.svg
 create mode 100644 gui/frontend/public/brands/nimbus.webp

diff --git a/gui/brand.go b/gui/brand.go
index 96004aa..4e7c3bc 100644
--- a/gui/brand.go
+++ b/gui/brand.go
@@ -60,7 +60,7 @@ var brandCatalog = map[string]Brand{
 	"nimbusbackup": {
 		Name:        "nimbusbackup",
 		Title:       "Nimbus Backup",
-		Logo:        "/brands/nimbus.svg",
+		Logo:        "/brands/nimbus.webp",
 		Accent:      "#667eea",
 		AccentHover: "#5a67d8",
 		BrandURL:    "https://nimbus.rdem-systems.com/en/?utm_source=NimbusGui&utm_medium=tooling",
diff --git a/gui/build/windows/icon.ico b/gui/build/windows/icon.ico
index f0372e23083e4de8fbd921af14060d275646c05f..b2627368ea80114a488164609f72123dab07d258 100644
GIT binary patch
