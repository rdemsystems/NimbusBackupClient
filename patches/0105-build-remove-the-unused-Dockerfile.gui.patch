From 9ba51369dd37fc64e1c7a16186838d31e4b4729d Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Tue, 20 Oct 2026 17:33:55 +0200
Subject: [PATCH 105/120] build: remove the unused Dockerfile.gui

Nothing referenced it (CI, Makefile, scripts, docs), it pinned Go 1.21,
and it could not build anyway: it copied gui/ alone, while gui/go.mod
resolves pbscommon, clientcommon, machinebackuplib, snapshot, retry and
security through replace directives to sibling folders. Linux GUI builds
go through the CI and BUILD.md; the MSI through build_msi_linux.sh.
---
 Dockerfile.gui | 55 --------------------------------------------------
 1 file changed, 55 deletions(-)
 delete mode 100644 Dockerfile.gui

diff --git a/Dockerfile.gui b/Dockerfile.gui
deleted file mode 100644
index fd34fec..0000000
--- a/Dockerfile.gui
+++ /dev/null
@@ -1,55 +0,0 @@
-# Dockerfile for building GUI in Docker
-# Useful for consistent builds
-
-FROM golang:1.21 AS builder
-
-# Install build dependencies for the Wails desktop frontend.
-# webkit2gtk-4.1 is the non-EOL WebKitGTK API; the "webkit2_41" build tag is
-# what makes cgo link against it (wails defaults to the EOL webkit2gtk-4.0).
-ARG GTK_PKG=libgtk-3-dev
-ARG WEBKIT_PKG=libwebkit2gtk-4.1-dev
-RUN apt-get update && apt-get install -y \
-    gcc \
-    pkg-config \
-    ${GTK_PKG} \
-    ${WEBKIT_PKG} \
-    && rm -rf /var/lib/apt/lists/*
-
-WORKDIR /build
-
-# Copy go mod files
-COPY gui/go.mod gui/go.sum ./
-RUN go mod download
-
-# Copy source
-COPY gui/ .
-
-# Build
-ARG VERSION=dev
-ARG COMMIT=unknown
-RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
-    -tags "desktop,production,webkit2_41" \
-    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
-    -o proxmox-backup-gui .
-
-# Runtime image (for testing GUI in container with X11)
-FROM ubuntu:22.04
-
-RUN apt-get update && apt-get install -y \
-    libgtk-3-0 \
-    libwebkit2gtk-4.1-0 \
-    libgdk-pixbuf-2.0-0 \
-    libgl1 \
-    libxcursor1 \
-    libxrandr2 \
-    libxinerama1 \
-    libxi6 \
-    libxxf86vm1 \
-    && rm -rf /var/lib/apt/lists/*
-
-COPY --from=builder /build/proxmox-backup-gui /usr/local/bin/
-
-# Note: GUI requires X11 display
-# Run with: docker run -e DISPLAY=$DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix proxmox-backup-gui
-
-ENTRYPOINT ["/usr/local/bin/proxmox-backup-gui"]
-- 
