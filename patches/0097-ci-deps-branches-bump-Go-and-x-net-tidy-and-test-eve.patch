From b9523568fabf252d19ef3f53630e72202fa4cfab Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Tue, 20 Oct 2026 16:50:53 +0200
Subject: [PATCH 097/108] ci: deps/** branches bump Go and x/net, tidy and test
 every module

Go 1.26.9 and golang.org/x/net v0.61.0 fix known net/http, crypto/tls and
http2 vulnerabilities, but go mod tidy cannot run on the dev machine (no
Go toolchain). A push to deps/<name> runs the bump with that toolchain,
vets every module for linux and windows, runs every module's tests, and
uploads the go.mod/go.sum changes as a patch artifact to commit on the
working branch.
---
 .github/workflows/deps-bump.yml | 95 +++++++++++++++++++++++++++++++++
 1 file changed, 95 insertions(+)
 create mode 100644 .github/workflows/deps-bump.yml

diff --git a/.github/workflows/deps-bump.yml b/.github/workflows/deps-bump.yml
new file mode 100644
index 0000000..44f063c
--- /dev/null
+++ b/.github/workflows/deps-bump.yml
@@ -0,0 +1,95 @@
+name: Go toolchain and dependency bump
+
+# Push a branch named deps/<anything> to run it. The job moves every module
+# to the Go version and x/net version below, runs go mod tidy, then builds,
+# vets (linux and windows) and tests every module with that toolchain. The
+# resulting go.mod/go.sum changes are uploaded as a patch artifact instead of
+# being pushed: a GITHUB_TOKEN push would not trigger Build and Release, and
+# the patch gets applied and committed on the working branch like any change.
+
+on:
+  push:
+    branches: [ 'deps/**' ]
+
+env:
+  GO_VERSION: '1.26.9'
+  XNET_VERSION: 'v0.61.0'
+
+jobs:
+  bump:
+    name: Bump, tidy and test
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-go@v5
+        with:
+          go-version: ${{ env.GO_VERSION }}
+
+      - name: Install dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y gcc libgl1-mesa-dev xorg-dev
+
+      - name: Bump x/net and tidy every module
+        env:
+          GOWORK: off
+          GOTOOLCHAIN: local
+        run: |
+          go version
+          for mod in $(find . -name go.mod -not -path '*/frontend/*' | sort); do
+            m=$(dirname "$mod")
+            echo "::group::$m"
+            if grep -q 'golang.org/x/net ' "$mod"; then
+              ( cd "$m" && go get "golang.org/x/net@${XNET_VERSION}" )
+            fi
+            ( cd "$m" && go mod tidy )
+            echo "::endgroup::"
+          done
+          git diff --stat
+
+      - name: Build and vet (linux, windows)
+        env:
+          GOWORK: off
+          GOTOOLCHAIN: local
+        run: |
+          fail=0
+          for mod in $(find . -name go.mod -not -path '*/frontend/*' | sort); do
+            m=$(dirname "$mod")
+            for os in linux windows; do
+              echo "::group::$m ($os)"
+              if ! ( cd "$m" && GOOS=$os go vet ./... ); then
+                echo "::error::go vet failed in $m for $os"
+                fail=1
+              fi
+              echo "::endgroup::"
+            done
+          done
+          exit $fail
+
+      - name: Test every module
+        env:
+          GOWORK: off
+          GOTOOLCHAIN: local
+        run: |
+          fail=0
+          for mod in $(find . -name go.mod -not -path '*/frontend/*' | sort); do
+            m=$(dirname "$mod")
+            echo "::group::$m"
+            if ! ( cd "$m" && go test -race ./... ); then
+              echo "::error::go test failed in $m"
+              fail=1
+            fi
+            echo "::endgroup::"
+          done
+          exit $fail
+
+      - name: Patch of the go.mod/go.sum changes
+        if: always()
+        run: git diff -- '*go.mod' '*go.sum' go.work > deps-bump.patch; wc -l deps-bump.patch
+
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: deps-bump-patch
+          path: deps-bump.patch
-- 
