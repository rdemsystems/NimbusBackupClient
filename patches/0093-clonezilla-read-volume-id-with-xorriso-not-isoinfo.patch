From 996af7215a88d84d718e1183566a22ca19616d2d Mon Sep 17 00:00:00 2001
From: Tiziano Bacocco <tizbac2@gmail.com>
Date: Sun, 18 Oct 2026 18:44:06 +0200
Subject: [PATCH 093/120] clonezilla: read volume id with xorriso, not isoinfo

Upstream: tizbac/proxmoxbackupclient_go@cee965ca4e26da4183d6f85d879abf338f213d4f
---
 PATCH-CLONEZILLA.md | 2 +-
 patch-clonezilla.sh | 7 +++++--
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/PATCH-CLONEZILLA.md b/PATCH-CLONEZILLA.md
index 560f98c..36aa5e2 100644
--- a/PATCH-CLONEZILLA.md
+++ b/PATCH-CLONEZILLA.md
@@ -55,7 +55,7 @@ removed on exit):
 ## Prerequisites
 
 - `xorriso` (>= 1.5), `unsquashfs`/`mksquashfs` (squashfs-tools), `7z`
-  (7-zip), `isoinfo` (genisoimage) — for reading the volume id.
+  (7-zip) — xorriso also reads the volume id (no genisoimage needed).
 - `patch` — to apply the unified-diff menu patches.
 - An isohybrid MBR prefix, normally
   `/usr/lib/ISOLINUX/isohdpfx.bin` or `/usr/lib/syslinux/bios/isohdpfx.bin`
diff --git a/patch-clonezilla.sh b/patch-clonezilla.sh
index 4f600e0..2ccd2c5 100755
--- a/patch-clonezilla.sh
+++ b/patch-clonezilla.sh
@@ -188,10 +188,13 @@ ROOTFS="$WORK/rootfs"
 NEW_SQFS="$WORK/filesystem.new"
 SQFS="$TREE$SQFS_PATH"
 
-# Volume id: explicit env wins, else read it back from the source ISO.
+# Volume id: explicit env wins, else read it back from the source ISO with
+# xorriso (already a hard requirement; avoids depending on genisoimage's
+# isoinfo). Never let a failed pipeline abort the script silently: a missing
+# volume id only falls back to the CLONEZILLA default below.
 VOL="${ISO_VOLUME:-}"
 if [ -z "$VOL" ]; then
-  VOL="$(isoinfo -d -i "$IN" 2>/dev/null | grep -i 'volume id' | sed -E 's/.*volume id:[[:space:]]*//' | tr -d '[:space:]')"
+  VOL="$(xorriso -indev "$IN" -pvd_info 2>/dev/null | sed -n 's/.*Volume Id[[:space:]]*:[[:space:]]*//p' | head -n1 | tr -d '[:space:]' || true)"
 fi
 [ -n "$VOL" ] || VOL="CLONEZILLA"
 
-- 
2.47.3

