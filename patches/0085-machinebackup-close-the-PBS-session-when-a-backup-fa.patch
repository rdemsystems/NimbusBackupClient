From: mjb-is <mjb-is@users.noreply.github.com>
Date: Thu, 15 Oct 2026 00:08:07 +0100
Subject: [PATCH 085/120] machinebackup: close the PBS session when a backup
 fails or is stopped

Backup only ended its PBS session through Finish, on success. A machine
backup that failed or was stopped after the session started left the
HTTP/2 connection open, so PBS kept the backup task running with the
group locked, and every later backup of that group from the same process
(the GUI, the service) failed with "connection lost: PBS session cannot
be resumed" until the process exited.

Backup now defers client.Close() right after Connect. Close is safe to
call more than once and after Finish.

zz_session_close_livetest_test.go (skipped unless PBS_LIVE_URL and the
other PBS_LIVE_* variables are set) stops a backup after its first block,
then backs up the same group again in the same process.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JSSBMF6hRk92jsHCMKgDRx
Upstream: tizbac/proxmoxbackupclient_go@9148294918bd67c8768da09f5846acbe5d4fa780
---
 machinebackuplib/machinebackup.go             |  5 ++
 .../zz_session_close_livetest_test.go         | 51 +++++++++++++++++++
 2 files changed, 56 insertions(+)
 create mode 100644 machinebackuplib/zz_session_close_livetest_test.go

diff --git a/machinebackuplib/machinebackup.go b/machinebackuplib/machinebackup.go
index 841214d..48a7e9d 100644
--- a/machinebackuplib/machinebackup.go
+++ b/machinebackuplib/machinebackup.go
@@ -509,6 +509,11 @@ func Backup(cfg *Config, progressCallback ProgressCallback) (*BackupResult, erro
 
 	//Physical drive paths will be like  "\\\\.\\PhysicalDrive0"
 	client.Connect(false, cfg.BackupType)
+	// A failed or stopped backup must drop its session too (Finish does it
+	// for a good one): left open, PBS keeps the backup task running and the
+	// group locked, so the next backup of the same group fails for as long
+	// as this process lives.
+	defer client.Close()
 	disks := make([]BackupDisk, 0)
 
 	// Calculate total size of all disks
diff --git a/machinebackuplib/zz_session_close_livetest_test.go b/machinebackuplib/zz_session_close_livetest_test.go
new file mode 100644
index 0000000..c08337c
--- /dev/null
+++ b/machinebackuplib/zz_session_close_livetest_test.go
@@ -0,0 +1,51 @@
+package machinebackuplib
+
+import (
+	"crypto/rand"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// TestStoppedBackupReleasesGroup backs up a small file, stops the backup
+// after its first block, then backs up the same group again in the same
+// process. Before Backup closed its session on every return, the stopped
+// run left PBS's backup task running with the group locked, and the second
+// run failed until the process exited.
+//
+// Needs a PBS: PBS_LIVE_URL, PBS_LIVE_AUTHID, PBS_LIVE_SECRET,
+// PBS_LIVE_FINGERPRINT, PBS_LIVE_DATASTORE (and optionally PBS_LIVE_NS).
+func TestStoppedBackupReleasesGroup(t *testing.T) {
+	url := os.Getenv("PBS_LIVE_URL")
+	if url == "" {
+		t.Skip("set PBS_LIVE_URL, PBS_LIVE_AUTHID, PBS_LIVE_SECRET, PBS_LIVE_FINGERPRINT, PBS_LIVE_DATASTORE")
+	}
+	dev := filepath.Join(t.TempDir(), "disk.img")
+	data := make([]byte, 12<<20)
+	if _, err := rand.Read(data); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(dev, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := &Config{
+		BaseURL:         url,
+		AuthID:          os.Getenv("PBS_LIVE_AUTHID"),
+		Secret:          os.Getenv("PBS_LIVE_SECRET"),
+		CertFingerprint: os.Getenv("PBS_LIVE_FINGERPRINT"),
+		Datastore:       os.Getenv("PBS_LIVE_DATASTORE"),
+		Namespace:       os.Getenv("PBS_LIVE_NS"),
+		BackupID:        "machine-session-close-test",
+		BackupDevices:   []string{dev},
+		BackupType:      "host",
+	}
+
+	stopAtFirstBlock := func(fraction float64, _ string) bool { return fraction > 0 }
+	if _, err := Backup(cfg, stopAtFirstBlock); !errors.Is(err, ErrCancelled) {
+		t.Fatalf("first backup: want ErrCancelled, got %v", err)
+	}
+	if _, err := Backup(cfg, nil); err != nil {
+		t.Fatalf("second backup of the same group after a stopped one: %v", err)
+	}
+}
