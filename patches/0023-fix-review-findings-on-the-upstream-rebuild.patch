+// diskIsGPT reports whether the disk with BackupDisk.Index index (the boot
+// disk the config selects) has a GPT partition table.
+func diskIsGPT(disks []BackupDisk, index int) bool {
+	for _, d := range disks {
+		if d.Index == index {
+			return d.GPT
+		}
+	}
+	return false
+}
