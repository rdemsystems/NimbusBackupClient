From 21016bd7e33a9731e9f588ea7306632391239f94 Mon Sep 17 00:00:00 2001
From: Richard DEMONGEOT <richard@rdem-systems.com>
Date: Fri, 9 Oct 2026 10:11:56 +0200
Subject: [PATCH 26/33] ci: run upstream's make lint over every module
 (informational)

---
 .github/workflows/build-and-release.yml | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/.github/workflows/build-and-release.yml b/.github/workflows/build-and-release.yml
index 7a4143e..85ba361 100644
--- a/.github/workflows/build-and-release.yml
+++ b/.github/workflows/build-and-release.yml
@@ -79,6 +79,31 @@ jobs:
         env:
           GOWORK: off
 
+  # Upstream's `make lint`: golangci-lint over EVERY module, not only gui.
+  # Informational until the existing findings outside gui are cleaned up:
+  # it reports, it does not block.
+  lint-all:
+    name: Lint all modules (informational)
+    runs-on: ubuntu-latest
+    continue-on-error: true
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-go@v5
+        with:
+          go-version: ${{ env.GO_VERSION }}
+
+      - name: Install dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y gcc libgl1-mesa-dev xorg-dev libgtk-3-dev libwebkit2gtk-4.1-dev
+
+      - name: Install golangci-lint
+        run: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.12.2
+
+      - name: make lint
+        run: make lint
+
   # Unit tests
   test:
     name: Unit Tests
-- 
