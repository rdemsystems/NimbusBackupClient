 gui/main.go            | 51 +++++++++++++++++++++++++++++++++++++-----
 gui/window_fit_test.go | 29 ++++++++++++++++++++++++
 3 files changed, 76 insertions(+), 5 deletions(-)
 create mode 100644 gui/window_fit_test.go

