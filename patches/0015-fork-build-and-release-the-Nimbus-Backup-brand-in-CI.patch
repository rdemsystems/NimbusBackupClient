           echo "" >> RELEASE_BODY.md
           echo "---" >> RELEASE_BODY.md
           echo "" >> RELEASE_BODY.md
-           echo "**Proxmox Backup Client** — [GitHub](https://github.com/tizbac/proxmoxbackupclient_go) · [Forum](https://forum.proxmox.com/)" >> RELEASE_BODY.md
