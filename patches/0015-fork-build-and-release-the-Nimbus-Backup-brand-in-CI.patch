+          Copy-Item NimbusBackup.msi ../../dist/
         shell: pwsh
 
       - name: Upload GUI artifacts
         uses: actions/upload-artifact@v4
         with:
-           name: ProxmoxBackupClient-Windows
-           path: |
-             dist/ProxmoxBackupClient.exe
-             dist/ProxmoxBackupClient.msi
+          name: NimbusBackup-Windows
+          path: |
+            dist/NimbusBackup.exe
+            dist/NimbusBackup.msi
 
   # Create release on tag
   release:
@@ -370,24 +393,24 @@ jobs:
           mkdir -p release
 
           # CLI Windows
-          cd artifacts/cli-Windows && zip ../../release/proxmoxbackup-cli-${{ steps.version.outputs.VERSION }}-windows.zip *
+          cd artifacts/cli-Windows && zip ../../release/nimbus-backup-cli-${{ steps.version.outputs.VERSION }}-windows.zip *
           cd ../..
 
