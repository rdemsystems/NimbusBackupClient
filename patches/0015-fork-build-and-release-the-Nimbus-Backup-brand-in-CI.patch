@@ -279,13 +299,13 @@ jobs:
               "ProductVersion": { "Major": $($p[0]), "Minor": $($p[1]), "Patch": $($p[2]), "Build": 0 }
             },
             "StringFileInfo": {
-              "CompanyName": "Proxmox Backup Client",
-              "FileDescription": "Proxmox Backup Client Service",
+              "CompanyName": "RDEM Systems",
+              "FileDescription": "Nimbus Backup Service",
               "FileVersion": "$ver",
-              "InternalName": "ProxmoxBackupClientSVC",
+              "InternalName": "NimbusBackupSVC",
               "LegalCopyright": "Copyright (c) 2024-2026 RDEM Systems",
-              "OriginalFilename": "ProxmoxBackupClientSVC.exe",
-              "ProductName": "Proxmox Backup Client",
+              "OriginalFilename": "NimbusBackupSVC.exe",
+              "ProductName": "Nimbus Backup",
               "ProductVersion": "$ver"
             },
             "VarFileInfo": { "Translation": { "LangID": "0409", "CharsetID": "04B0" } }
@@ -300,14 +320,14 @@ jobs:
         env:
           GOWORK: off
         run: |
-          go build -tags service -trimpath -buildmode=pie -ldflags "-s -w -X main.appVersion=${{ steps.version.outputs.VERSION }}" -o build/bin/ProxmoxBackupClientSVC.exe
+          go build -tags service -trimpath -buildmode=pie -ldflags "-s -w -X main.appVersion=${{ steps.version.outputs.VERSION }}" -o build/bin/NimbusBackupSVC.exe
         shell: pwsh
 
       - name: Copy binaries to dist
         run: |
           New-Item -ItemType Directory -Force -Path dist
-           Copy-Item gui/build/bin/ProxmoxBackupClient.exe dist/
-           Copy-Item gui/build/bin/ProxmoxBackupClientSVC.exe dist/
+          Copy-Item gui/build/bin/NimbusBackup.exe dist/
+          Copy-Item gui/build/bin/NimbusBackupSVC.exe dist/
         shell: pwsh
 
       - name: Install WiX Toolset
@@ -322,18 +342,21 @@ jobs:
         run: |
           # Pass the resolved version to the WiX preprocessor so MSI
           # metadata matches the tag / ldflags version.
-          candle.exe "-dProductVersion=${{ steps.version.outputs.VERSION_MSI }}" Product.wxs -ext WixUIExtension -ext WixUtilExtension
-           light.exe Product.wixobj -ext WixUIExtension -ext WixUtilExtension -out ProxmoxBackupClient.msi
-           Copy-Item ProxmoxBackupClient.msi ../../dist/
+          # Fork patch: build the Nimbus brand entry (NimbusBackup.wxs keeps the
