@@ -430,8 +453,8 @@ jobs:
           emitted=0
           VER="${{ steps.version.outputs.VERSION }}"
           # Use the version-stamped copies so the published label reads
-          # "ProxmoxBackupClient-v0.2.106.msi" (identical bytes → same VT report).
-           for f in "release/ProxmoxBackupClient-${VER}.exe" "release/ProxmoxBackupClient-${VER}.msi"; do
+          # "NimbusBackup-v0.2.106.msi" (identical bytes → same VT report).
+          for f in "release/NimbusBackup-${VER}.exe" "release/NimbusBackup-${VER}.msi"; do
             [ -f "$f" ] || continue
             name=$(basename "$f")
             sha=$(sha256sum "$f" | awk '{print $1}')
