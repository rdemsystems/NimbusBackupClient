-          cd artifacts/cli-Linux && tar -czf ../../release/proxmoxbackup-cli-${{ steps.version.outputs.VERSION }}-linux.tar.gz *
+          cd artifacts/cli-Linux && tar -czf ../../release/nimbus-backup-cli-${{ steps.version.outputs.VERSION }}-linux.tar.gz *
           cd ../..
 
           # CLI macOS
-          cd artifacts/cli-macOS && tar -czf ../../release/proxmoxbackup-cli-${{ steps.version.outputs.VERSION }}-macos.tar.gz *
+          cd artifacts/cli-macOS && tar -czf ../../release/nimbus-backup-cli-${{ steps.version.outputs.VERSION }}-macos.tar.gz *
           cd ../..
 
-           # GUI Windows - Add .exe, .msi (with and without version) and .zip
-           cd artifacts/ProxmoxBackupClient-Windows
-           cp ProxmoxBackupClient.exe ../../release/ProxmoxBackupClient-${{ steps.version.outputs.VERSION }}.exe
-           cp ProxmoxBackupClient.exe ../../release/ProxmoxBackupClient.exe
-           cp ProxmoxBackupClient.msi ../../release/ProxmoxBackupClient-${{ steps.version.outputs.VERSION }}.msi
-           cp ProxmoxBackupClient.msi ../../release/ProxmoxBackupClient.msi
-           zip ../../release/ProxmoxBackupClient-${{ steps.version.outputs.VERSION }}-windows.zip *
