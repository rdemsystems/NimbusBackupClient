-        # Pinned to v2.12.0 — the exact version @latest resolved to in the
-        # green v0.2.106 build, so we ship identical bytes while keeping a
-        # DETERMINISTIC build toolchain (the CLI orchestrates frontend bundling
-        # + asset embedding before `go build`, so a floating CLI would make
-        # even the .exe non-reproducible). Do NOT pin to the library version in
-        # gui/go.mod (v2.8.0): that CLI tag fails to build under Go 1.25.
-        # Bumping the library to match is a separate, tested task.
-        run: go install github.com/wailsapp/wails/v2/cmd/wails@v2.12.0
+        # Pinned to the wails library version in gui/go.mod (v2.13.0, bumped by
+        # upstream so the GUI builds on Debian 13 / webkit2gtk-4.1). A floating
+        # CLI would make the build non-reproducible (the CLI orchestrates
+        # frontend bundling + asset embedding before `go build`); a CLI older
+        # than the library prints a version-mismatch warning and may miss
+        # template changes. Bump both together.
+        run: go install github.com/wailsapp/wails/v2/cmd/wails@v2.13.0
 
       - name: Install Frontend Dependencies
         working-directory: gui/frontend
@@ -251,6 +252,25 @@ jobs:
           echo "VERSION_MSI=$version_msi" >> $env:GITHUB_OUTPUT
           echo "Building version: $version (MSI: $version_msi)"
 
+      # Fork patch: upstream's wails.json carries the neutral "Proxmox Backup
+      # Client" identity. Stamp the Nimbus Backup name/company into it before
+      # the build so the GUI exe is NimbusBackup.exe (ProductBody.wxi installs
+      # $(var.ExeName).exe; gui/brand.go picks the brand from that exe name)
+      # with Nimbus version-info resources. Version is left untouched.
+      - name: Apply Nimbus Backup brand to wails.json
+        shell: pwsh
+        run: |
+          $w = Get-Content gui/wails.json -Raw | ConvertFrom-Json
+          $w.name = "NimbusBackup"
+          $w.outputfilename = "NimbusBackup"
+          $w.author.name = "RDEM Systems"
+          $w.author.email = "contact@rdem-systems.com"
+          $w.info.companyName = "RDEM Systems"
+          $w.info.productName = "Nimbus Backup"
+          $w.info.copyright = "© 2024-2026 RDEM Systems and Proxmox Backup Client GO contributors."
+          $w.info.comments = "Backup client for Proxmox Backup Server"
+          $w | ConvertTo-Json -Depth 10 | Set-Content gui/wails.json -Encoding utf8
+
       - name: Build GUI
         working-directory: gui
         env:
@@ -260,7 +280,7 @@ jobs:
       # The service is a plain `go build` from gui/ and would otherwise ship
       # with no Windows version info — a strong heuristic/ML false-positive
       # signal (Codex review). Generate a .syso with proper CompanyName /
-      # ProductName / version so ProxmoxBackupClientSVC.exe looks like normal signed-
