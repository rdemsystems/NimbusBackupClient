diff --git a/gui/scheduler.go b/gui/scheduler.go
index 9e2ac3f..f3286fa 100644
--- a/gui/scheduler.go
+++ b/gui/scheduler.go
@@ -402,6 +402,137 @@ func (j *ScheduledJob) validate() error {
