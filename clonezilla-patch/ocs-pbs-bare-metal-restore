#!/bin/bash
# ocs-pbs-bare-metal-restore - fully automated PBS bare-metal restore.
#
# Launched directly at boot (via the "Salvanza - PBS Bare Metal Restore"
# GRUB/isolinux menu entry's ocs_live_run= boot parameter),
# BEFORE Clonezilla's own interactive language/keyboard prompts or main menu
# ever appear (those are also skipped via that same menu entry's
# locales=/keyboard-layouts= boot params). Walks straight through: network
# up, PBS server/credentials, pick a snapshot, attach it via NBD, auto-detect
# the target disk, double-confirm, then invoke ocs-onthefly directly with a
# precomputed command line -- Clonezilla's own generic
# device-image/device-device/beginner-mode wizard tree is never shown at
# all, unlike the manual "pbs-nbd" menu entry (ocs-pbs-nbd), which still
# hands off to that generic wizard afterward.
#
# Deliberately NOT sharing code with ocs-pbs-nbd (some duplication of the
# network/credentials/snapshot-picker/NBD-attach steps below): that script
# is proven reliable after a long live debugging session tonight
# (2026-09-24) and must not be touched/risked while THIS script is still
# getting its own first real test. Worth consolidating into shared functions
# later, once this path has its own track record.
#
# Usage: ocs-pbs-bare-metal-restore [NBD_NUMBER]    (default: 0 -> /dev/nbd0)

DRBL_SCRIPT_PATH="${DRBL_SCRIPT_PATH:-/usr/share/drbl}"
. $DRBL_SCRIPT_PATH/sbin/drbl-conf-functions
. /etc/drbl/drbl-ocs.conf
. $DRBL_SCRIPT_PATH/sbin/ocs-functions
[ -e "/etc/ocs/ocs-live.conf" ] && . /etc/ocs/ocs-live.conf

check_if_root
check_if_in_clonezilla_live
ask_and_load_lang_set
mkdir -p $ocs_log_dir
check_DIA_set_ESC $DIA

PBSNBD="/usr/local/sbin/pbsnbd"
NBDNUM="${1:-0}"
NBDDEV="/dev/nbd${NBDNUM}"
DIA_TMP="$(mktemp /tmp/pbsbmr-dia.XXXXXX)"
LIST_TMP="$(mktemp /tmp/pbsbmr-list.XXXXXX)"
LIST_ERR="$(mktemp /tmp/pbsbmr-err.XXXXXX)"
ATTACH_LOG="/tmp/pbsbmr-attach-$$.log"
# What the terminal shows when the wizard stops before the restore starts.
STOPPED="PBS Bare Metal Restore stopped. Nothing has been written to any disk."
# Every dialog's title starts with this.
TITLE="PBS Bare Metal Restore"
# For "Start again" in the menu shown after a stop.
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
ARGS=("$@")
# What the server said when something failed, word for word (the dialogs say
# it in plain words).
WIZ_LOG="${ocs_log_dir:-/var/log/clonezilla}"
WIZ_LOG="${WIZ_LOG%/}/pbs-bare-metal-restore.log"

# Sizes for the dialogs: gib BYTES gives "29.1 GiB", commas N gives
# 23,404,216,320.
gib() { numfmt --to=iec-i --suffix=B --format=%.1f "${1:-0}" 2>/dev/null | sed -E 's/\.0([KMGTP]iB)$/\1/; s/([0-9])([KMGTP]?i?B)$/\1 \2/'; }
commas() { sed -E ':a; s/^([0-9]+)([0-9]{3})/\1,\2/; ta' <<<"$1"; }
# readable FILE: the lines of a pbsnbd log that a person can read: no Go
# stack trace (lines with .go:NN or goroutine, function call lines, indented
# lines), no blank lines, and no Go date and time or "panic: " prefix.
readable() {
  grep -vE '\.go:[0-9]|goroutine|^[[:space:]]|^[A-Za-z0-9_./*()-]+\(.*\)( \.\.\.)?$|^$' "$1" 2>/dev/null |
    sed -E 's#^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9:]{8}(\.[0-9]+)? ##; s/^panic: //'
}
# collapse: the same prefix twice in a row once only, so "ticket login
# failed: ticket login failed: HTTP 401" reads "ticket login failed: HTTP 401".
collapse() { sed -E ':a; s/(^|: )([^:]+): \2: /\1\2: /; ta'; }
# plain_error TEXT: a known failure from pbsnbd (TEXT) in plain words, or
# nothing when it is not one of these. Uses the answers given so far.
plain_error() {
  local e="$1" host="${PBS_SERVER#https://}"
  host="${host%%/*}"
  if grep -qiE 'ticket' <<<"$e" && grep -qiE '401|permission check failed|authentication|unauthori[sz]ed' <<<"$e"; then
    echo "The server refused the user name or password."
  elif grep -qiE 'x509|certificate|tls: ' <<<"$e"; then
    echo "A secure connection to the server at ${host} could not be made: the server's certificate was not accepted."
  elif grep -qiE 'HTTP response to HTTPS client' <<<"$e"; then
    echo "The server at ${host} did not answer as a secure (https) server. Check the port in the address; a Proxmox Backup Server uses 8007."
  elif grep -qiE 'connection refused|no route to host|network is unreachable|host is unreachable|timed out|timeout|deadline exceeded|no such host|server misbehaving|dial tcp|connection reset' <<<"$e"; then
    echo "The server could not be reached at ${host}."
  elif grep -qiE 'namespace not found' <<<"$e"; then
    echo "There is no namespace called ${PBS_NS} in datastore ${PBS_DS} on that server."
  elif grep -qiE 'HTTP error: 404|HTTP 404|does not exist|no such datastore|datastore .*not found' <<<"$e"; then
    echo "There is no datastore called ${PBS_DS} on that server."
  elif grep -qiE '401|unauthori[sz]ed' <<<"$e"; then
    echo "The server refused the user name or password."
  elif grep -qiE '403|permission check failed' <<<"$e"; then
    echo "The user ${PBS_USER} may not see the backups in datastore ${PBS_DS}, or there is no datastore called ${PBS_DS} on that server."
  fi
  return 0
}
# when TIME: a backup time as people read it, "Wed 11 Nov 2026 06:00 UTC", in
# the restore system's time zone; TIME itself when date cannot read it.
when() { date -d "$1" '+%a %-d %b %Y %H:%M %Z' 2>/dev/null || printf '%s' "$1"; }

# Box sizes. whiptail makes a box whose height or width is 0 as wide as its
# longest line, so a long prompt stretched a box to the full screen width.
# These boxes are about 70 columns (less on a narrow screen), the prompt is
# wrapped onto as many lines as it needs and the height worked out from that.
SCRCOLS="$(tput cols 2>/dev/null || echo 80)"
SCRLINES="$(tput lines 2>/dev/null || echo 25)"
BOXW=70
[ "$BOXW" -gt $((SCRCOLS - 4)) ] && BOXW=$((SCRCOLS - 4))
# text_rows TEXT [WIDTH]: the lines TEXT takes wrapped in a box WIDTH wide
# (BOXW by default); a little more than whiptail needs, never less.
text_rows() { printf '%b\n' "$1" | fold -s -w $(( ${2:-$BOXW} - 6 )) | wc -l; }
# box_hw TEXT: height and width for an inputbox, passwordbox, infobox or
# short message. whiptail keeps the room for buttons even in an infobox,
# which draws none: with too little height its last line was cut off.
box_hw() {
  local h=$(( $(text_rows "$1") + 7 ))
  [ "$h" -gt $((SCRLINES - 2)) ] && h=$((SCRLINES - 2))
  echo "$h $BOXW"
}
# dia ARGS: $DIA, except that a --msgbox, --yesno or --infobox given a height
# and width of 0 0 gets box_hw's size for its text instead. whiptail stretches
# a 0 0 box to its longest line, so a long message (the "restore is complete"
# box, the stop and error boxes) ran from edge to edge of the screen.
dia() {
  local a=() i=0 n=$# v
  local -a in=("$@")
  while [ $i -lt $n ]; do
    v="${in[$i]}"
    a+=("$v")
    case "$v" in
      --msgbox|--yesno|--infobox)
        if [ $((i + 3)) -lt $((n + 1)) ] && [ "${in[$((i + 2))]}" = 0 ] && [ "${in[$((i + 3))]}" = 0 ]; then
          local hw
          hw="$(box_hw "${in[$((i + 1))]}")"
          a+=("${in[$((i + 1))]}" ${hw})
          i=$((i + 4))
          continue
        fi
        ;;
    esac
    i=$((i + 1))
  done
  "$DIA" "${a[@]}"
}
# menu_hw TEXT TAG DESC [TAG DESC ...]: height, width and list height for a
# menu with TEXT above these entries. whiptail shows an entry as its tag, a
# space and its text in a list 14 columns narrower than the box, or 19 with a
# scroll bar (measured on the 3.3.3 live system), and cuts off the rest: the
# box is made wide enough for the longest entry (MENU_PAD, MENU_PAD_SCROLL
# with a column to spare), up to the screen's width less 4.
MENU_PAD=16
MENU_PAD_SCROLL=21
menu_hw() {
  local text="$1" w=$BOXW wide=0 n=0 l h pad=$MENU_PAD
  shift
  while [ $# -ge 2 ]; do
    [ $(( ${#1} + ${#2} )) -gt "$wide" ] && wide=$(( ${#1} + ${#2} ))
    n=$((n + 1))
    shift 2
  done
  l=$n
  [ "$l" -gt 12 ] && l=12
  [ "$l" -lt "$n" ] && pad=$MENU_PAD_SCROLL
  [ $((wide + pad)) -gt "$w" ] && w=$((wide + pad))
  [ "$w" -gt $((SCRCOLS - 4)) ] && w=$((SCRCOLS - 4))
  h=$(( $(text_rows "$text" "$w") + l + 8 ))
  while [ "$h" -gt $((SCRLINES - 2)) ] && [ "$l" -gt 3 ]; do
    l=$((l - 1))
    h=$((h - 1))
  done
  # A list made shorter on a small screen scrolls: room for the scroll bar.
  if [ "$l" -lt "$n" ] && [ "$pad" = "$MENU_PAD" ] && [ $((wide + MENU_PAD_SCROLL)) -gt "$w" ]; then
    w=$((wide + MENU_PAD_SCROLL))
    [ "$w" -gt $((SCRCOLS - 4)) ] && w=$((SCRCOLS - 4))
  fi
  echo "$h $w $l"
}
# cut_words TEXT MAX: TEXT, or when it is longer than MAX, as much of it as
# fits with "..." after it, cut where a word ends (at a space, - or _) when
# that keeps at least half of it.
cut_words() {
  local s="$1" m="$2" p q
  if [ "${#s}" -le "$m" ]; then printf '%s' "$s"; return 0; fi
  p="${s:0:$((m - 3))}"
  case "${s:$((m - 3)):1}" in
    " "|-|_) ;;
    *)
      q="${p%[ _-]*}"
      [ "${#q}" -ge $(( (m - 3) / 2 )) ] && p="$q"
      ;;
  esac
  while [ -n "$p" ]; do
    case "${p: -1}" in " "|-|_|,|.|:|";"|"(") p="${p%?}" ;; *) break ;; esac
  done
  printf '%s...' "$p"
}
# Button names for a yes/no box: whiptail and dialog name the option apart.
yes_no_labels() {
  case "$(basename "$DIA")" in
    dialog) printf '%s\n' --yes-label "$1" --no-label "$2" ;;
    *)      printf '%s\n' --yes-button "$1" --no-button "$2" ;;
  esac
}

# on_nbd SYSDIR: true when the block device at SYSDIR (/sys/block/X) sits on
# an NBD device, directly, through a partition of it, through a loop device
# over it, or through device-mapper devices stacked on those.
on_nbd() {
  local s n
  for s in "$1"/slaves/*; do
    [ -e "$s" ] || continue
    n="$(basename "$s")"
    case "$n" in
      nbd*) return 0 ;;
      loop*) case "$(cat "/sys/block/$n/loop/backing_file" 2>/dev/null)" in /dev/nbd*) return 0 ;; esac ;;
      dm-*) on_nbd "/sys/block/$n" && return 0 ;;
    esac
  done
  return 1
}
# The shrink tool's check cache (CACHE in pbs-shrink-restore): what it worked
# out from the backup, kept so that choosing scratch space, and the restore
# after the plan, do not read the whole backup again. It belongs to the
# attached backup, so it goes whenever the backup is let go.
SHRINK_CACHE="/tmp/pbs-shrink-plan.cache"
# release_image: let go of the backup's disk image so the next run can attach
# it again. A run stopped short can leave the shrink tool's mounts, loop
# devices and device-mapper views on /dev/nbdN, or a volume group the live
# system activated from the backup; while anything holds the NBD device, a
# new pbsnbd cannot attach to it. Quiet, and safe to run more than once.
release_image() {
  local m d n pass lp i
  rm -f "$SHRINK_CACHE"
  for m in $(findmnt -rno TARGET 2>/dev/null | grep -E '^(/mnt/pbs-scratch|/run/pbs-shrink-mnt)' | sort -r); do
    umount "$m" >/dev/null 2>&1 || umount -l "$m" >/dev/null 2>&1
  done
  # Loop devices over the image, over the shrink tool's views or over its
  # scratch file: detached now, or marked to go once nothing uses them.
  for lp in $(losetup -l -n -O NAME,BACK-FILE 2>/dev/null | awk '$2 ~ /^\/dev\/(nbd|mapper\/pbs)/ || $2 ~ /pbs-shrink/ {print $1}'); do
    losetup -d "$lp" >/dev/null 2>&1
  done
  # Device-mapper devices on the image, the topmost first (a few passes for
  # stacked ones), then the shrink tool's own names wherever they are.
  for pass in 1 2 3 4; do
    udevadm settle --timeout=5 >/dev/null 2>&1
    n=0
    for d in /sys/block/dm-*; do
      [ -e "$d" ] || continue
      [ -z "$(ls -A "$d/holders" 2>/dev/null)" ] || continue
      on_nbd "$d" || continue
      dmsetup remove --retry "$(cat "$d/dm/name")" >/dev/null 2>&1 && n=$((n + 1))
    done
    [ "$n" -gt 0 ] || break
  done
  for d in $(dmsetup ls 2>/dev/null | awk '$1 ~ /^(pbsshrink|pbslv[0-9]+|pbstlv[0-9]+)$/ {print $1}'); do
    dmsetup remove --retry "$d" >/dev/null 2>&1
  done
  for lp in $(losetup -l -n -O NAME,BACK-FILE 2>/dev/null | awk '$2 ~ /^\/dev\/(nbd|mapper\/pbs)/ || $2 ~ /pbs-shrink/ {print $1}'); do
    losetup -d "$lp" >/dev/null 2>&1
  done
  partx -d "$NBDDEV" >/dev/null 2>&1
  # Then pbsnbd itself, and the NBD device disconnected. The saved sign-in
  # (with the password) goes with it.
  rm -f "$CRED_FILE"
  if pgrep -x pbsnbd >/dev/null 2>&1; then
    echo "Stopping the earlier connection to the backup (pbsnbd, PID: $(pgrep -x pbsnbd | tr '\n' ' '))..."
    pkill -INT -x pbsnbd 2>/dev/null
    i=0
    while pgrep -x pbsnbd >/dev/null 2>&1 && [ $i -lt 8 ]; do sleep 1; i=$((i + 1)); done
    pgrep -x pbsnbd >/dev/null 2>&1 && pkill -KILL -x pbsnbd 2>/dev/null
  fi
  if [ -e "/sys/block/${NBDDEV#/dev/}" ]; then
    command -v nbd-client >/dev/null 2>&1 && nbd-client -d "$NBDDEV" >/dev/null 2>&1
    i=0
    while [ "$(cat "/sys/block/${NBDDEV#/dev/}/size" 2>/dev/null || echo 0)" != "0" ] && [ $i -lt 20 ]; do
      sleep 0.5
      i=$((i + 1))
    done
  fi
  return 0
}
# From the attach on, until the restore itself starts, every exit of this
# wizard (No, cancel, an error) lets go of the image.
RELEASE_ON_EXIT=0
on_exit() {
  rm -f "$DIA_TMP" "$LIST_TMP" "$LIST_ERR"
  if [ "$RELEASE_ON_EXIT" = "1" ]; then
    echo "Letting go of the backup's disk image ..."
    release_image
  fi
}
trap "rm -f \"$DIA_TMP\" \"$LIST_TMP\" \"$LIST_ERR\"" HUP INT QUIT TERM
trap on_exit EXIT

# stopped: the wizard stopped before anything was written, because the
# person chose to (No, Cancel) or because it could not go on (a refused
# sign-in, no backups, a key that would not open): every such box says what
# to put right and that nothing was written. Neither is a failed restore, so Clonezilla's red "finished with error!" and its "Cloning
# finished" menu are not shown: our own menu is, and this script never
# returns to Clonezilla with an error. Exit code 99 is Clonezilla's own for
# "go to the command line" (ocs-live-run-menu then shows no error and no menu
# of its own); "Start again" runs this wizard afresh in place of this run.
stopped() {
  local c t h w l
  echo "$STOPPED"
  rm -f "$SHRINK_CACHE" "$CRED_FILE"
  if [ "$RELEASE_ON_EXIT" = "1" ]; then
    echo "Letting go of the backup's disk image ..."
    release_image
    RELEASE_ON_EXIT=0
  fi
  t="The restore was stopped. Nothing was written.\n\nWhat would you like to do now?"
  read -r h w l <<<"$(menu_hw "$t" a "Start again" b "Power off" c "Reboot" d "Command line")"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - stopped" --nocancel \
  --menu "$t" "$h" "$w" "$l" \
  a "Start again" \
  b "Power off" \
  c "Reboot" \
  d "Command line" \
  2> "$DIA_TMP"
  c="$(cat "$DIA_TMP" 2>/dev/null)"
  case "$c" in
    a)
      rm -f "$DIA_TMP" "$LIST_TMP" "$LIST_ERR"
      clear
      # The network is up already: the new run skips looking for it again.
      # The saved sign-in file is gone, so the server, user name and
      # datastore are handed over to fill in the boxes again (never the
      # password, which is always asked for).
      PBSBMR_RESTART=1 PBSBMR_SERVER="${PBS_SERVER:-$SAVED_SERVER}" PBSBMR_USER="${PBS_USER:-$SAVED_USER}" \
      PBSBMR_DSNS="${PBS_DS_NS:-$SAVED_DSNS}" exec "$SELF" "${ARGS[@]}"
      ;;
    b)
      clear
      echo "Switching the computer off ..."
      poweroff
      ;;
    c)
      clear
      echo "Restarting the computer ..."
      reboot
      ;;
    *)
      echo "To start the restore again, type: sudo $SELF"
      ;;
  esac
  exit 99
}

path_without_comment() { printf '%s' "${1%%\#*}"; }
comment_of_line() {
  case "$1" in
    *#*) printf '%s' "${1##*\#}" ;;
    *)   printf '' ;;
  esac
}

# The sign-in, for filling in the boxes of the next run. It holds the
# password, so it goes whenever the wizard stops or lets go of the backup
# (release_image); "Start again" hands over the rest (PBSBMR_SERVER,
# PBSBMR_USER, PBSBMR_DSNS).
CRED_FILE="/tmp/pbsnbd-credentials"
save_credentials() {
  {
    echo "server|$PBS_SERVER"
    echo "username|$PBS_USER"
    echo "password|$PBS_PASS"
    echo "datastore|$PBS_DS_NS"
  } > "$CRED_FILE"
  chmod 600 "$CRED_FILE"
}
load_credentials() {
  SAVED_SERVER="${PBSBMR_SERVER:-}"; SAVED_USER="${PBSBMR_USER:-}"; SAVED_PASS=""; SAVED_DSNS="${PBSBMR_DSNS:-}"
  [ -f "$CRED_FILE" ] || return 0
  while IFS='|' read -r key value; do
    [ -n "$key" ] || continue
    case "$key" in
      server)   SAVED_SERVER="$value" ;;
      username) SAVED_USER="$value" ;;
      password) SAVED_PASS="$value" ;;
      datastore) SAVED_DSNS="$value" ;;
    esac
  done < "$CRED_FILE"
  return 0
}

echo "=== PBS Bare Metal Restore (fully automated) ==="

load_credentials

# 1. network up. Auto-attempt DHCP on every detected NIC FIRST, silently --
# network_config_if_necessary (below) only runs Clonezilla's own interactive
# ocs-live-netcfg wizard (which is where BOTH the "DHCP or static?" choice
# AND its own internal time-sync prompt live) when it finds NO IP already
# configured, so a successful pre-emptive DHCP here skips that whole
# interactive wizard entirely -- this is the zero-prompt path for the
# common case (a real network with DHCP). If DHCP genuinely isn't
# available, network_config_if_necessary still falls back to the
# interactive wizard as a safety net, same as it always did.
# "Start again" after a stop (PBSBMR_RESTART=1) skips this: the network is
# already up, possibly set by hand, and must not be asked for again.
if [ "${PBSBMR_RESTART:-0}" != "1" ]; then
  for nic in /sys/class/net/*; do
    dev="$(basename "$nic")"
    [ "$dev" = "lo" ] && continue
    echo "> Looking for a network address on ${dev} (DHCP)..."
    dhcpcd -t 15 "$dev" >/dev/null 2>&1
  done
fi
network_config_if_necessary

# Sync time via NTP automatically, no prompt either way: -b (batch, never
# asks anything, including the interactive timezone/RTC fallback this
# script has for a no-internet case -- that fallback is deliberately
# skipped, not just silenced, since it needs a human's timezone answer) and
# -i (internet-based sync only). Touches /run/live/ocs-live-time-sync on
# success, which ALSO makes ocs-live-netcfg's own internal time-sync prompt
# (see above) correctly skip itself if the interactive network fallback
# above ever runs after this succeeds.
ocs-live-time-sync -b -i >/dev/null 2>&1 || true

# 2. start from a clean slate: anything an earlier run left on the image
# (the shrink tool's loop and device-mapper devices, mounts, pbsnbd itself)
# is let go, and the NBD device disconnected, or the new attach fails.
release_image

# 3. load the NBD kernel module
if ! modprobe nbd max_part=0; then
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - start" \
  --msgbox "The restore system could not load the part of Linux it needs to read the backup (the nbd kernel module).\n\nNothing has been written to any disk.\n\nStart the computer from the restore stick again. If this happens again, make the restore stick again." 0 0 $DIA_ESC
  stopped
fi
sleep 1

# 4a. PBS server URL
# Cancel (or Esc) in any of these boxes stops the wizard.
ask_="true"
while [ "$ask_" = "true" ]; do
  T="Address of the backup server (Proxmox Backup Server), for example https://pbs.example.com:8007"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - backup server" \
  --inputbox "$T" $(box_hw "$T") "${SAVED_SERVER:-https://}" $DIA_ESC \
  2> "$DIA_TMP" || stopped
  PBS_SERVER="$(cat "$DIA_TMP")"
  case "$PBS_SERVER" in
    https://*) [ "$PBS_SERVER" != "https://" ] && ask_="false" ;;
    *) ;;
  esac
  if [ "$ask_" = "true" ]; then
    dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - backup server" \
    --yesno "The address must be complete and start with https://\nFor example: https://pbs.example.com:8007\n\nTry again?" 0 0
    [ "$?" = "0" ] || stopped
  fi
done
echo "PBS server URL  : $PBS_SERVER"

# 4b. PBS username/password
ask_="true"
while [ "$ask_" = "true" ]; do
  T="User name on the backup server, with its realm after the @, for example root@pam or backup@pbs:"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - user name" \
  --inputbox "$T" $(box_hw "$T") "${SAVED_USER:-root@pam}" $DIA_ESC \
  2> "$DIA_TMP" || stopped
  PBS_USER="$(cat "$DIA_TMP")"
  case "$PBS_USER" in
    *@*) ask_="false" ;;
    *) ;;
  esac
  if [ "$ask_" = "true" ]; then
    dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - user name" \
    --yesno "The user name must include its realm after an @, for example root@pam or backup@pbs.\n\nTry again?" 0 0
    [ "$?" = "0" ] || stopped
  fi
done
echo "PBS username    : $PBS_USER"

# The password box always starts empty. Filled in from the last run (shown as
# stars), what was typed was added to the old password and the sign-in
# failed. The server, user name and datastore are filled in: they can be seen.
ask_="true"
while [ "$ask_" = "true" ]; do
  T="Password for ${PBS_USER} on the backup server:"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - password" \
  --passwordbox "$T" $(box_hw "$T") \
  2> "$DIA_TMP" || stopped
  PBS_PASS="$(cat "$DIA_TMP")"
  if [ -n "$PBS_PASS" ]; then
    ask_="false"
  else
    dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - password" \
    --yesno "The password cannot be empty.\n\nTry again?" 0 0
    [ "$?" = "0" ] || stopped
  fi
done
echo "PBS password    : (entered)"

# 4c. datastore (optionally with a namespace after the first "/")
ask_="true"
while [ "$ask_" = "true" ]; do
  T="Datastore on the backup server that holds the backups.\nIf they are in a namespace, add it after a /, for example store1 or store1/office:"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - datastore" \
  --inputbox "$T" $(box_hw "$T") "${SAVED_DSNS}" $DIA_ESC \
  2> "$DIA_TMP" || stopped
  PBS_DS_NS="$(cat "$DIA_TMP")"
  case "$PBS_DS_NS" in
    '')      ;;
    /*)      ;;
    *)       ask_="false" ;;
  esac
  if [ "$ask_" = "true" ]; then
    dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - datastore" \
    --yesno "The datastore cannot be empty or start with a /.\nFor example: store1  or  store1/office\n\nTry again?" 0 0
    [ "$?" = "0" ] || stopped
  fi
done
PBS_DS="${PBS_DS_NS%%/*}"
if [ "$PBS_DS_NS" != "${PBS_DS_NS#*/}" ]; then
  PBS_NS="${PBS_DS_NS#*/}"
else
  PBS_NS=""
fi
NS_OPT=""
[ -n "$PBS_NS" ] && NS_OPT="-namespace $PBS_NS"
echo "PBS datastore   : ${PBS_DS}"
echo "PBS namespace   : ${PBS_NS:-<none>}"

save_credentials

# 4e. optional encryption key. Snapshots made with a keyfile (client-side
# AES-256-GCM) need the same key to be attached; pbsnbd only reads the key
# during start-up, so the file is a private copy in /tmp and any USB stick
# can be unplugged again straight away.
KEY_ARGS=()
KEYFILE=""
KEYPASS=""
KEY_PROTECTED=0
KEY_COPY="/tmp/pbs-encryption-key.json"
KEY_MNT="/mnt/pbs-keystick"
KEY_TITLE="$TITLE - encryption key"
KEYQ=(none "No, the backups are not encrypted"
      usb  "Yes, the key file is on a USB stick or other disk"
      path "Yes, I will type the path of the key file")
T="Were these backups made with an encryption key?"
dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
  --menu "$T" $(menu_hw "$T" "${KEYQ[@]}") \
  "${KEYQ[@]}" \
  2> "$DIA_TMP" || stopped
KEY_CHOICE="$(cat "$DIA_TMP")"
case "$KEY_CHOICE" in
  path)
    T="Full path of the encryption key file, for example /run/live/medium/key.json:"
    dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
      --inputbox "$T" $(box_hw "$T") "" 2> "$DIA_TMP" || stopped
    KEYFILE="$(cat "$DIA_TMP")"
    ;;
  usb)
    PARTS=()
    while read -r dev fstype size label; do
      [ -n "$dev" ] || continue
      PARTS+=("$dev" "${fstype} ${size} ${label}")
    done < <(lsblk -rpno NAME,FSTYPE,SIZE,LABEL,TYPE 2>/dev/null | awk '$5=="part" && $2!="" && $1 !~ /nbd/ {print $1, $2, $3, $4}')
    if [ ${#PARTS[@]} -eq 0 ]; then
      dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
        --msgbox "No USB stick or disk with a readable partition was found, so the key file cannot be loaded.\n\nNothing has been written to any disk.\n\nPlug in the USB stick that holds the key file and start the restore again." 0 0 $DIA_ESC
      stopped
    fi
    T="Which partition holds the encryption key file?"
    dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
      --menu "$T" $(menu_hw "$T" "${PARTS[@]}") "${PARTS[@]}" 2> "$DIA_TMP" || stopped
    KEY_PART="$(cat "$DIA_TMP")"
    [ -n "$KEY_PART" ] || stopped
    mkdir -p "$KEY_MNT"
    if ! mount -o ro "$KEY_PART" "$KEY_MNT" 2>/dev/null; then
      dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
        --msgbox "${KEY_PART} could not be opened (mounted), so the key file on it cannot be read.\n\nNothing has been written to any disk.\n\nStart the restore again and choose another partition, or copy the key file to a USB stick formatted as FAT32, exFAT or NTFS." 0 0 $DIA_ESC
      stopped
    fi
    KEYMENU=()
    while read -r f; do
      [ -n "$f" ] || continue
      KEYMENU+=("$f" "")
    done < <(find "$KEY_MNT" -maxdepth 3 -type f -name '*.json' -size -8k 2>/dev/null | sort)
    if [ ${#KEYMENU[@]} -eq 0 ]; then
      umount "$KEY_MNT" 2>/dev/null
      dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
        --msgbox "No key file (a .json file) was found on ${KEY_PART}. Only its top three folder levels are searched.\n\nNothing has been written to any disk.\n\nStart the restore again and choose the partition that holds the key file." 0 0 $DIA_ESC
      stopped
    fi
    if [ ${#KEYMENU[@]} -eq 2 ]; then
      KEYFILE="${KEYMENU[0]}"
    else
      T="Which file is the encryption key?"
      if ! dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
        --menu "$T" $(menu_hw "$T" "${KEYMENU[@]}") "${KEYMENU[@]}" 2> "$DIA_TMP"; then
        umount "$KEY_MNT" 2>/dev/null
        stopped
      fi
      KEYFILE="$(cat "$DIA_TMP")"
    fi
    if [ -n "$KEYFILE" ]; then
      ( umask 077; cp "$KEYFILE" "$KEY_COPY" )
      KEYFILE="$KEY_COPY"
    fi
    umount "$KEY_MNT" 2>/dev/null
    ;;
esac
if [ "$KEY_CHOICE" != "none" ] && [ -n "$KEY_CHOICE" ]; then
  if [ -z "$KEYFILE" ] || [ ! -r "$KEYFILE" ]; then
    dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
      --msgbox "The key file ${KEYFILE:-(none chosen)} cannot be read.\n\nNothing has been written to any disk.\n\nStart the restore again and check the path, or the USB stick that holds the key file." 0 0 $DIA_ESC
    stopped
  fi
  KEY_ARGS=(-keyfile "$KEYFILE")
  # A key file protected by a passphrase has an object as "kdf" (Scrypt or
  # PBKDF2); an unprotected one has null.
  if grep -Eq '"kdf"[[:space:]]*:[[:space:]]*\{' "$KEYFILE"; then
    KEY_PROTECTED=1
    T="This key file is protected by a passphrase. Enter it:"
    dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
      --passwordbox "$T" $(box_hw "$T") 2> "$DIA_TMP" || stopped
    KEYPASS="$(cat "$DIA_TMP")"
  fi
  echo "Encryption key  : ${KEYFILE}"
else
  echo "Encryption key  : <none>"
fi

# 5. list the backups
echo "> Listing backups on ${PBS_SERVER} (datastore=${PBS_DS}${PBS_NS:+, namespace=${PBS_NS}})..."
# pbsnbd unlocks the key before it lists anything, so a mistyped passphrase
# fails here. Give three attempts in total before giving up.
# The password and the key passphrase go to pbsnbd in its environment
# (PBS_PASSWORD, PBS_ENCRYPTION_PASSWORD), not as arguments, which ps shows.
KEY_TRIES=1
while ! PBS_PASSWORD="$PBS_PASS" PBS_ENCRYPTION_PASSWORD="$KEYPASS" \
     "$PBSNBD" -baseurl "$PBS_SERVER" -username "$PBS_USER" \
     -datastore "$PBS_DS" $NS_OPT "${KEY_ARGS[@]}" -list -sizes > "$LIST_TMP" 2> "$LIST_ERR"; do
  if [ "$KEY_PROTECTED" = "1" ] && grep -qi 'wrong password' "$LIST_ERR"; then
    if [ "$KEY_TRIES" -ge 3 ]; then
      dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
      --msgbox "The passphrase did not unlock the key file, three times.\n\nNothing has been written to any disk.\n\nStart the restore again when you have the right passphrase." 0 0 $DIA_ESC
      stopped
    fi
    dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
      --msgbox "That passphrase did not unlock the key file (attempt ${KEY_TRIES} of 3). Please try again." 0 0 $DIA_ESC
    KEY_TRIES=$((KEY_TRIES + 1))
    T="Passphrase for the encryption key (attempt ${KEY_TRIES} of 3):"
    dia --backtitle "$msg_nchc_free_software_labs" --title "$KEY_TITLE" \
      --passwordbox "$T" $(box_hw "$T") 2> "$DIA_TMP" || stopped
    KEYPASS="$(cat "$DIA_TMP")"
    continue
  fi
  # The server's own words go to the log; the box says it plainly.
  RAW="$(readable "$LIST_ERR" | collapse | tail -n 6 | cut -c1-300)"
  { echo "$(date '+%F %T') the backups could not be listed (${PBS_SERVER}, ${PBS_USER}, ${PBS_DS_NS}):"; cat "$LIST_ERR"; } >> "$WIZ_LOG" 2>/dev/null
  WHY="$(plain_error "$RAW")"
  [ -n "$WHY" ] || WHY="The backups could not be listed. The server or the network said:\n\n${RAW}"
  T="${WHY}\n\nNothing has been written to any disk.\n\nCheck the server address, user name, password and datastore, and that this computer is on the network, then start the restore again.\n\nThe full message is in ${WIZ_LOG}."
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - backups" \
  --msgbox "$T" $(box_hw "$T") $DIA_ESC
  stopped
done
# -sizes starts each line with the image's size in bytes and a tab: the sizes
# are kept apart (FSIZE, by path) for the disk image menu, and LIST_TMP keeps
# the lines as they were.
declare -A FSIZE
SIZE_RE="^([0-9]+)"$'\t'"(.*)$"
while IFS= read -r line; do
  if [[ "$line" =~ $SIZE_RE ]]; then
    FSIZE[$(path_without_comment "${BASH_REMATCH[2]}")]="${BASH_REMATCH[1]}"
    printf '%s\n' "${BASH_REMATCH[2]}"
  else
    printf '%s\n' "$line"
  fi
done < "$LIST_TMP" > "$LIST_TMP.lines"
mv -f "$LIST_TMP.lines" "$LIST_TMP"
# The comment of each backup group (a Salvanza machine backup puts the
# machine's name there), shown next to it: "vm/9000198  Deepthought". Not
# needed: without it (an older pbsnbd, an error) the menu shows the names only.
declare -A GCOMMENT
while IFS=$'\t' read -r g c; do
  [ -n "$g" ] && [ -n "$c" ] && GCOMMENT[$g]="$c"
done < <(PBS_PASSWORD="$PBS_PASS" "$PBSNBD" -baseurl "$PBS_SERVER" -username "$PBS_USER" \
           -datastore "$PBS_DS" $NS_OPT -groups 2>>"$WIZ_LOG")
if [ ! -s "$LIST_TMP" ]; then
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - backups" \
  --msgbox "No backups were found in datastore '${PBS_DS}'${PBS_NS:+ (namespace '${PBS_NS}')}.\n\nNothing has been written to any disk.\n\nCheck the datastore and namespace names, and that this user may see the backups, then start the restore again." 0 0 $DIA_ESC
  stopped
fi

# 6. three-level selection: (a) <kind>/<backupid>, (b) date, (c) .fidx file
declare -A KDT
declare -a KDT_ORDER
while IFS= read -r line; do
  [ -n "$line" ] || continue
  r2="${line#*/}"; r3="${r2#*/}"
  kdt="${line%%/*}/${r2%%/*}|${r3%%/*}"
  if [ -z "${KDT[$kdt]+x}" ]; then
    KDT[$kdt]=1
    KDT_ORDER+=("$kdt")
  else
    KDT[$kdt]=$((KDT[$kdt]+1))
  fi
done < "$LIST_TMP"

declare -a KEYS
declare -A KEY_N
n=0
for kdt in "${KDT_ORDER[@]}"; do
  key="${kdt%%|*}"
  if [ -z "${KEY_N[$key]+x}" ]; then
    KEY_N[$key]=$((n+1))
    KEYS+=("$key")
    n=$((n+1))
  fi
done
# Each machine's name: the group's comment, else a snapshot comment from the
# list, if any, on one line.
declare -A KCOMMENT
for key in "${KEYS[@]}"; do
  comment="${GCOMMENT[$key]}"
  if [ -z "$comment" ]; then
    while IFS= read -r line; do
      r2="${line#*/}"
      [ "${line%%/*}/${r2%%/*}" = "$key" ] || continue
      comment="$(comment_of_line "$line")"
      break
    done < "$LIST_TMP"
  fi
  KCOMMENT[$key]="$(tr -s '[:space:]' ' ' <<<"$comment" | sed -E 's/^ //; s/ $//')"
done
if [ "$n" -gt 1 ]; then
  # Named machines first, by name, then the rest by type and ID (numbers in
  # numeric order). The tags number them as shown; SORTED maps a tag back.
  declare -a MENU1 SORTED
  mapfile -t SORTED < <(for key in "${KEYS[@]}"; do
      if [ -n "${KCOMMENT[$key]}" ]; then
        printf '0\t%s\t%s\n' "${KCOMMENT[$key],,}" "$key"
      else
        printf '1\t%s\t%s\n' "$key" "$key"
      fi
    done | sort -t $'\t' -k1,1n -k2,2V -k3,3V | cut -f3)
  # The IDs padded to the longest, so the names line up; a name cut at a
  # word to fit the screen (the tag, the ID and the menu's own frame).
  IDW=0
  for key in "${SORTED[@]}"; do [ "${#key}" -gt "$IDW" ] && IDW=${#key}; done
  NAMEW=$(( SCRCOLS - 4 - MENU_PAD_SCROLL - ${#n} - IDW - 2 ))
  [ "$NAMEW" -gt 50 ] && NAMEW=50
  [ "$NAMEW" -lt 12 ] && NAMEW=12
  i=1
  for key in "${SORTED[@]}"; do
    label="$key"
    [ -n "${KCOMMENT[$key]}" ] && label="$(printf '%-*s  %s' "$IDW" "$key" "$(cut_words "${KCOMMENT[$key]}" "$NAMEW")")"
    MENU1+=("$i" "$label")
    i=$((i+1))
  done
  T="Which machine do you want to restore?"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - choose the machine" \
  --menu "$T" $(menu_hw "$T" "${MENU1[@]}") \
  "${MENU1[@]}" $DIA_ESC \
  2> "$DIA_TMP"
  CHOICE1="$(cat "$DIA_TMP")"
  [ -n "$CHOICE1" ] || stopped
  KEY="${SORTED[$((CHOICE1-1))]}"
else
  KEY="${KEYS[0]}"
fi
echo "Selected backup ID : $KEY"
# The machine as the dialogs name it: "vm/9000198 (Deepthought)".
KEY_NAME="$KEY"
[ -n "${KCOMMENT[$KEY]}" ] && KEY_NAME="$KEY ($(cut_words "${KCOMMENT[$KEY]}" 40))"

declare -a MENU2
declare -a DATES2
i=1
for kdt in "${KDT_ORDER[@]}"; do
  [ "${kdt%%|*}" = "$KEY" ] || continue
  dt="${kdt#*|}"
  # "Wed 11 Nov 2026 06:00 UTC", and "2 disks" when the backup holds more
  # than one disk image. The tag (a number) picks DATES2 as before.
  label="$(when "$dt")"
  [ "${KDT[$kdt]}" -gt 1 ] && label="$label  (${KDT[$kdt]} disks)"
  MENU2+=("$i" "$label")
  DATES2+=("$dt")
  i=$((i+1))
done
num2=$((i-1))
if [ "$num2" -gt 1 ]; then
  T="Backups of ${KEY_NAME}. Choose the date to restore from:"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - choose the date" \
  --menu "$T" $(menu_hw "$T" "${MENU2[@]}") \
  "${MENU2[@]}" $DIA_ESC \
  2> "$DIA_TMP"
  CHOICE2="$(cat "$DIA_TMP")"
  [ -n "$CHOICE2" ] || stopped
  DT="${DATES2[$((CHOICE2-1))]}"
else
  DT="${DATES2[0]}"
fi
DT_NAME="$(when "$DT")"
echo "Selected backup    : $KEY/$DT"

# The disk images of the chosen backup in their order (drive-sata0 before
# drive-scsi0, drive-scsi2 before drive-scsi10), each with its size.
declare -a MENU3
declare -a LINES3
mapfile -t LINES3 < <(while IFS= read -r line; do
    [ -n "$line" ] || continue
    r2="${line#*/}"; f2="${r2%%/*}"; r3="${r2#*/}"; dt="${r3%%/*}"
    [ "${line%%/*}/${f2}" = "$KEY" ] || continue
    [ "$dt" = "$DT" ] || continue
    printf '%s\t%s\n' "$(path_without_comment "${r3#*/}")" "$line"
  done < "$LIST_TMP" | sort -t $'\t' -k1,1V | cut -f2-)
FILEW=0
for line in "${LINES3[@]}"; do
  file="$(path_without_comment "${line#*/*/*/}")"
  [ "${#file}" -gt "$FILEW" ] && FILEW=${#file}
done
i=1
for line in "${LINES3[@]}"; do
  file="$(path_without_comment "${line#*/*/*/}")"
  sz="${FSIZE[$(path_without_comment "$line")]}"
  if [ -n "$sz" ] && [ "$sz" -gt 0 ] 2>/dev/null; then
    MENU3+=("$i" "$(printf '%-*s  %s' "$FILEW" "$file" "$(gib "$sz")")")
  else
    MENU3+=("$i" "$file")
  fi
  i=$((i+1))
done
num3=$((i-1))
if [ "$num3" -gt 1 ]; then
  T="The backup of ${KEY_NAME} from ${DT_NAME} holds more than one disk image. Choose the one to restore:"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - choose the disk" \
  --menu "$T" $(menu_hw "$T" "${MENU3[@]}") \
  "${MENU3[@]}" $DIA_ESC \
  2> "$DIA_TMP"
  CHOICE3="$(cat "$DIA_TMP")"
  [ -n "$CHOICE3" ] || stopped
  SELECTED="${LINES3[$((CHOICE3-1))]}"
else
  SELECTED="${LINES3[0]}"
fi
echo "Selected file      : $SELECTED"

# 7. attach in the foreground this time (we need it up before continuing,
# unlike ocs-pbs-nbd's fork-and-return-to-menu design) -- setsid so it
# survives this script's own exit once the restore is running.
echo "> Attaching '${SELECTED}' to ${NBDDEV}..."
PBS_PASSWORD="$PBS_PASS" PBS_ENCRYPTION_PASSWORD="$KEYPASS" \
setsid "$PBSNBD" -baseurl "$PBS_SERVER" -username "$PBS_USER" \
     -datastore "$PBS_DS" $NS_OPT "${KEY_ARGS[@]}" -nbd "$NBDNUM" -path "$SELECTED" < /dev/null > "$ATTACH_LOG" 2>&1 &
PBSNBD_PID=$!
RELEASE_ON_EXIT=1

# /dev/nbdN exists as soon as the nbd module is loaded, so wait for it to
# report a size. pbsnbd exits without attaching when it cannot read the image
# (wrong or missing encryption key, unreachable server). A busy server can
# take 20 s or more before pbsnbd has opened the backup (seen 15/11/2026, when
# a wait of 20 s stopped pbsnbd while it was still fetching), so the wait goes
# on while pbsnbd runs and has logged no error, for up to 2 minutes, and ends
# at once when it exits or logs one.
PBS_HOST="${PBS_SERVER#https://}"
PBS_HOST="${PBS_HOST%%/*}"
ATTACH_MAX=120
# attach_error: pbsnbd has logged a failure: a Go panic, one of its own
# "pbsnbd: " messages (it exits after those) or a refused sign-in.
attach_error() { grep -qE '^panic: |^pbsnbd: |^ticket login failed' "$ATTACH_LOG" 2>/dev/null; }
T="Connecting to the backup on ${PBS_HOST} ...\n\n${ATTACH_MAX} s so far. A busy server can take a minute or more."
ATTACH_HW="$(box_hw "$T")"
ATTACH_T0="$(date +%s)"
SHOWN=-1
while true; do
  [ "$(blockdev --getsize64 "$NBDDEV" 2>/dev/null || echo 0)" -gt 0 ] && break
  pgrep -x pbsnbd >/dev/null 2>&1 || break
  attach_error && break
  WAITED=$(( $(date +%s) - ATTACH_T0 ))
  [ "$WAITED" -ge "$ATTACH_MAX" ] && break
  if [ "$WAITED" != "$SHOWN" ]; then
    SHOWN="$WAITED"
    dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - open the backup" \
    --infobox "Connecting to the backup on ${PBS_HOST} ...\n\n${WAITED} s so far. A busy server can take a minute or more." $ATTACH_HW
  fi
  sleep 0.5
done
if [ "$(blockdev --getsize64 "$NBDDEV" 2>/dev/null || echo 0)" -le 0 ]; then
  # A plain explanation, from what pbsnbd logged (never its Go stack trace).
  ERRLINE="$(readable "$ATTACH_LOG" | collapse | grep -iE 'error|fail|cannot|could not|denied|refused|busy|invalid|wrong|timeout|unable' | head -n 1 | cut -c1-200)"
  [ -n "$ERRLINE" ] || ERRLINE="$(readable "$ATTACH_LOG" | collapse | head -n 1 | cut -c1-200)"
  if pgrep -x pbsnbd >/dev/null 2>&1 && ! attach_error; then
    # Still at it after the whole wait: no error to show.
    ERRLINE=""
    WHY="The backup server at ${PBS_HOST} did not open the backup within $((ATTACH_MAX / 60)) minutes. It may be busy, for example with a backup, verify or garbage collection job.\n\nStart the restore again, or wait until the server is less busy."
  elif grep -qiE 'resource busy|device busy|is busy|already in use|ebusy' "$ATTACH_LOG" 2>/dev/null; then
    WHY="The device the backup is read through (${NBDDEV}) is still held by an earlier attempt.\n\nStart the restore again. If this happens again, restart the computer from the restore stick and start the restore again."
  elif [ "${#KEY_ARGS[@]}" -gt 0 ] && grep -qiE 'decrypt|cipher|message authentication|encryption|key ?file|fingerprint|wrong key' "$ATTACH_LOG" 2>/dev/null; then
    WHY="The backup could not be decrypted with the chosen key file.\n\nStart the restore again and choose the key file these backups were made with."
  elif grep -qiE 'decrypt|encrypted|needs a key|no key' "$ATTACH_LOG" 2>/dev/null; then
    WHY="This backup is encrypted.\n\nStart the restore again and answer Yes to the encryption key question, with the key file these backups were made with."
  elif grep -qiE '401|403|unauthori[sz]ed|permission denied|authentication|login|ticket|password' "$ATTACH_LOG" 2>/dev/null; then
    WHY="The backup server did not accept the user name or password, or this user may not read this backup.\n\nStart the restore again and check them."
  elif grep -qiE 'connection refused|connection reset|no route|unreachable|timed out|timeout|no such host|dial tcp|tls|x509|certificate|EOF' "$ATTACH_LOG" 2>/dev/null; then
    WHY="The backup server could not be reached, or the connection broke.\n\nCheck the network and that the server is running, then start the restore again."
  else
    WHY="If the backup is encrypted, check that you chose the right key file. Otherwise check the network and that the server is running, then start the restore again."
  fi
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - open the backup" \
  --msgbox "The chosen backup could not be opened for reading.\n\n${ERRLINE:+The error was: ${ERRLINE}\n\n}${WHY}\n\nNothing has been written to any disk.\n\nFull details: ${ATTACH_LOG}" 0 0 $DIA_ESC
  stopped
fi
partprobe "$NBDDEV" >/dev/null 2>&1
partx -a "$NBDDEV" >/dev/null 2>&1
udevadm settle --timeout=10 >/dev/null 2>&1

# 8. auto-detect the target disk: the one non-NBD, non-removable, non-loop,
# non-optical local block device that is not the boot stick. Zero or more
# than one -> ask, never guess on an ambiguous multi-disk machine (this is an
# irreversible drive-wipe).
#
# The boot stick: a USB SSD often reports removable=0, and a Ventoy stick
# serves the ISO through device-mapper, so neither is caught by the checks
# above. Find the disk(s) under the live medium instead, from the mount's
# MAJ:MIN through sysfs: device-mapper slaves are followed down and a
# partition gives its disk. Names in /dev are not used, because under Ventoy
# the medium is mounted from /dev/mapper/ventoy but udev never creates that
# link in the live system (only /dev/dm-0 exists). A Ventoy stick is also
# recognised by its device-mapper device named "ventoy" and by its VTOYEFI
# partition, which still hold when the live system was copied to RAM (toram)
# and the medium is no longer mounted.
BOOT_DISKS=" "
VENTOY_DISKS=" "
add_boot_disk() { case "$BOOT_DISKS" in *" $1 "*) ;; *) BOOT_DISKS+="$1 " ;; esac; }
disks_of_dev() {
  local sys s
  sys="$(readlink -f "/sys/dev/block/$1" 2>/dev/null)"
  [ -n "$sys" ] && [ -e "$sys" ] || return 0
  if [ -n "$(ls -A "$sys/slaves" 2>/dev/null)" ]; then
    for s in "$sys"/slaves/*; do disks_of_dev "$(cat "$s/dev")"; done
  elif [ -f "$sys/partition" ]; then
    echo "/dev/$(basename "$(dirname "$sys")")"
  else
    echo "/dev/$(basename "$sys")"
  fi
}
disk_size() { local b; b="$(blockdev --getsize64 "$1" 2>/dev/null)"; [ -n "$b" ] && gib "$b"; }
for mm in $(findmnt -nro MAJ:MIN /run/live/medium 2>/dev/null); do
  for d in $(disks_of_dev "$mm"); do add_boot_disk "$d"; done
done
for d in $(for dm in /sys/block/dm-*; do
             [ "$(cat "$dm/dm/name" 2>/dev/null)" = "ventoy" ] && disks_of_dev "$(cat "$dm/dev")"
           done) \
         $(lsblk -nrpo NAME,PKNAME,LABEL 2>/dev/null | awk '$3=="VTOYEFI" && $2!=""{print $2}'); do
  add_boot_disk "$d"
  VENTOY_DISKS+="$d "
done

# The boot disk(s) are named in the dialogs below, so it is clear why the
# stick is not offered: "Not offered as the target: /dev/sdb (0.5 GiB) ...".
NOT_ELIGIBLE=""
for d in $BOOT_DISKS; do
  # A CD or DVD drive (or a VM's virtual one) is a disc, anything else a stick.
  case "$d" in
    /dev/sr*) what="the disc this restore system started from" ;;
    *) what="the stick this restore system started from" ;;
  esac
  case "$VENTOY_DISKS" in *" $d "*) what="the stick this restore system started from (Ventoy)" ;; esac
  sz="$(disk_size "$d")"
  NOT_ELIGIBLE+="\n  $d  (${sz:-unknown size})  $what"
done
NOT_ELIGIBLE_BLOCK=""
if [ -n "$NOT_ELIGIBLE" ]; then
  NOT_ELIGIBLE_BLOCK="\n\nNot offered as the target:$NOT_ELIGIBLE"
  echo -e "Not offered as the target:$NOT_ELIGIBLE"
fi

declare -a CANDIDATES
for bd in /sys/block/*; do
  name="$(basename "$bd")"
  case "$name" in
    nbd*|loop*|sr*|ram*|zram*|dm-*) continue ;;
  esac
  [ -f "$bd/removable" ] && [ "$(cat "$bd/removable" 2>/dev/null)" = "1" ] && continue
  case "$BOOT_DISKS" in *" /dev/$name "*) continue ;; esac
  [ -b "/dev/$name" ] && CANDIDATES+=("/dev/$name")
done

if [ "${#CANDIDATES[@]}" -eq 0 ]; then
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - target disk" \
  --msgbox "No disk was found to restore onto.${NOT_ELIGIBLE_BLOCK}\n\nNothing has been written to any disk.\n\nCheck that the computer's own disk is connected and turned on in the firmware (BIOS or UEFI) setup, then start the restore again." 0 0 $DIA_ESC
  stopped
elif [ "${#CANDIDATES[@]}" -eq 1 ]; then
  TARGET="${CANDIDATES[0]}"
else
  declare -a MENUT
  i=1
  for c in "${CANDIDATES[@]}"; do
    sz="$(disk_size "$c")"
    MENUT+=("$i" "$c  (${sz:-unknown size})")
    i=$((i+1))
  done
  T="This computer has more than one disk. Choose the disk to restore onto. EVERYTHING on it will be PERMANENTLY OVERWRITTEN.${NOT_ELIGIBLE_BLOCK}"
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - target disk" \
  --menu "$T" $(menu_hw "$T" "${MENUT[@]}") \
  "${MENUT[@]}" $DIA_ESC \
  2> "$DIA_TMP"
  CHOICET="$(cat "$DIA_TMP")"
  [ -n "$CHOICET" ] || stopped
  TARGET="${CANDIDATES[$((CHOICET-1))]}"
fi
echo "Target disk        : $TARGET"

SRC_SIZE="$(disk_size "$NBDDEV")"
TGT_SIZE="$(disk_size "$TARGET")"

# A target smaller than the source cannot take the source's partition table
# (-k0 below), so Clonezilla cannot restore onto it. pbs-shrink-restore can
# when the data fits (issue #153): it shrinks the partition with the most
# room, moves the ones after it, and copies used blocks only. Its plan is
# shown first; nothing is written until the confirmation below. A larger
# target goes through Clonezilla as before.
SHRINK_TOOL="/usr/local/sbin/pbs-shrink-restore"
SHRINK=0
# The plan is a table: keep its spaces. Only dialog has --no-collapse; whiptail
# (what $DIA is on the 3.3.3 live system) keeps them anyway and refuses the option.
NOCOLLAPSE=""
case "$(basename "$DIA")" in dialog) NOCOLLAPSE="--no-collapse" ;; esac
# The plan dialogs: about 100 columns, less on a narrow screen, so the box
# keeps a margin instead of filling the screen edge to edge, and never wider
# than the screen less 4 columns.
PLANW=$(( SCRCOLS - 8 ))
[ "$PLANW" -gt 100 ] && PLANW=100
[ "$PLANW" -lt 72 ] && PLANW=72
[ "$PLANW" -gt $((SCRCOLS - 4)) ] && PLANW=$((SCRCOLS - 4))
# The shrink tool's plan table is wrapped to a little less than the box's
# text width, so its columns stay in line and plan_wrap leaves it alone.
PLAN_COLS=$((PLANW - 8))
# None of the plan boxes scrolls. whiptail's --scrolltext puts the focus in
# the text, with no button highlighted: Enter then does nothing until Tab is
# pressed (seen at 800x600, and the same in a box with only OK). A text too
# tall for the screen is shown in pages instead (plan_msg), and a question
# under such a text gets a small box of its own (plan_ask).
# plan_wrap TEXT: TEXT with each \n made a new line and wrapped for a box
# PLANW wide. whiptail wraps at the box's width less 4; at less 6 here it
# never wraps a line again, so the rows counted are the rows it shows.
plan_wrap() { printf '%b\n' "$1" | fold -s -w $((PLANW - 6)); }
# nlines TEXT: the lines in TEXT, as it is (already wrapped).
nlines() { printf '%s\n' "$1" | wc -l; }
# BOX_EXTRA: the rows a message or Yes/No box needs besides its text: with
# fewer, whiptail 0.52 cut off the last line of the text.
BOX_EXTRA=6
# plan_max: the most rows a plan box may have: the screen less 4, so its
# title stays clear of the back title on the top line (at 800x600, 37 rows,
# a box of the screen less 2 touched it).
plan_max() { echo $(( SCRLINES - 4 )); }
# plan_fits TEXT: true when TEXT fits in one plan box.
plan_fits() { [ $(( $(plan_wrap "$1" | wc -l) + BOX_EXTRA )) -le "$(plan_max)" ]; }
# plan_pages TEXT: TEXT wrapped (plan_wrap) and cut into pages that each fit
# a plan box, separated by form feeds. A page ends at a blank line when there
# is one in its lower half, and no page starts with a blank line.
plan_pages() {
  local cap=$(( $(plan_max) - BOX_EXTRA ))
  [ "$cap" -lt 5 ] && cap=5
  plan_wrap "$1" | awk -v cap="$cap" '
    { line[NR] = $0 }
    END {
      n = NR; i = 1; first = 1
      while (i <= n) {
        while (i <= n && line[i] == "") i++
        if (i > n) break
        last = i + cap - 1
        if (last >= n) last = n
        else {
          for (j = last + 1; j > i + cap / 2; j--) if (line[j] == "") break
          if (j > i + cap / 2) last = j - 1
        }
        while (last > i && line[last] == "") last--
        if (!first) printf "\f"
        first = 0
        for (k = i; k <= last; k++) print line[k]
        i = last + 1
      }
    }'
}
# ok_label LABEL: the options that name the button of a message box.
ok_label() {
  case "$(basename "$DIA")" in
    dialog) printf '%s\n' --ok-label "$1" ;;
    *)      printf '%s\n' --ok-button "$1" ;;
  esac
}
# plan_msg TITLE TEXT [LABEL]: TEXT in a message box PLANW wide whose button
# is LABEL (OK when not given). A TEXT too tall for the screen is shown in
# pages, "(1 of 2)" after the title, each page but the last with a Next
# button. Returns 1 when a page is closed with Esc.
plan_msg() {
  local title="$1" label="${3:-OK}" pages p i n t
  local -a lbl
  mapfile -d $'\f' -t pages < <(plan_pages "$2")
  n=${#pages[@]}
  for ((i = 0; i < n; i++)); do
    p="${pages[$i]%$'\n'}"
    mapfile -t lbl < <(ok_label "$label")
    [ $((i + 1)) -lt "$n" ] && mapfile -t lbl < <(ok_label "Next")
    t="$title"
    [ "$n" -gt 1 ] && t="$title ($((i + 1)) of $n)"
    dia --backtitle "$msg_nchc_free_software_labs" --title "$t" $NOCOLLAPSE "${lbl[@]}" \
    --msgbox "$p" $(( $(nlines "$p") + BOX_EXTRA )) "$PLANW" $DIA_ESC || return 1
  done
  return 0
}
# plan_ask TITLE PLAN QUESTION: PLAN, a line, then QUESTION, in one Yes/No
# box when that fits on the screen. When it does not, PLAN comes first in a
# box of its own (plan_msg, its button Next), then QUESTION in a small Yes/No
# box with Yes highlighted, so Enter always has a button. Returns 0 for Yes.
plan_ask() {
  local title="$1" plan="$2" q="$3" t
  t="${plan}\n\n${SEP}\n${q}"
  if plan_fits "$t"; then
    t="$(plan_wrap "$t")"
    dia --backtitle "$msg_nchc_free_software_labs" --title "$title" $NOCOLLAPSE \
    --yesno "$t" $(( $(nlines "$t") + BOX_EXTRA )) "$PLANW"
    return
  fi
  plan_msg "$title" "$plan" "Next" || return 1
  dia --backtitle "$msg_nchc_free_software_labs" --title "$title" \
  --yesno "$q" $(box_hw "$q")
}
# A line between the plan and the question under it.
SEP="$(printf '%*s' $((PLANW - 8)) '' | tr ' ' '-')"
SCRATCH="/tmp/pbs-shrink"     # RAM; a partition on another disk when that is too small
SCRATCH_MNT=""
SCRATCH_DEV=""                # the partition chosen for scratch space
SCRATCH_FREE_MB=""            # its free space as the scratch space menu showed it
NEED_MB=""                    # the scratch space the plan needs, from the tool
# What the backup is, for the key of the shrink tool's check cache: another
# backup never meets the results worked out for this one.
SHRINK_ID="${PBS_SERVER}|${PBS_DS}|${NS_OPT}|${SELECTED}"
OSNAME="the operating system" # "Windows" when the backup has an NTFS partition
SRC_BYTES="$(blockdev --getsize64 "$NBDDEV" 2>/dev/null)"
TGT_BYTES="$(blockdev --getsize64 "$TARGET" 2>/dev/null)"

# no_scratch [REASON]: the restore cannot go on without scratch space. Says
# what can be done instead, and stops (the image is let go on the way out).
no_scratch() {
  local t need="at least $(commas "$NEED_MB") MB"
  [ -n "$NEED_MB" ] || need="enough"
  t="${1:+$1\n\n}Without suitable scratch space this restore cannot be done automatically onto the $(gib "$TGT_BYTES") disk. Nothing has been written to it.\n\nWhat you can do instead:\n\na) Start the restore again with a USB stick or another disk that has ${need} free (exFAT, NTFS or ext4). It is only used during the restore, and nothing else on it is touched.\n\nb) Restore onto a disk of at least $(gib "$SRC_BYTES"), the size of the backed up disk. That needs no scratch space.\n\nc) Install ${OSNAME} and the Salvanza backup client on this disk, then use the app's Restore page to open the disk image from this backup and restore your folders and files from it. Programs must be reinstalled, and the disk and ${OSNAME} get new identities.\n\nPress OK to stop. The backup itself is not changed."
  plan_msg "$TITLE - no scratch space" "$t"
  stopped
}

# Lets the user pick scratch space for a big cut: a partition on a disk that
# is not the target (a USB stick will do). It is mounted, a folder is made on
# it for the restore and removed afterwards; nothing else there is touched.
# When a partition cannot be mounted, the user can choose again. With none to
# choose from yet (a stick just plugged in may not be seen yet), the user can
# look again or stop; on Stop, or on Cancel, the wizard stops through
# no_scratch.
# part_free DEV FS: the free space on partition DEV (file system FS) in bytes,
# or nothing when it cannot be read. A partition that is not mounted is
# mounted read-only for a moment, with no journal or log replayed, so nothing
# is written to it.
part_free() {
  local m opts dir=/run/pbs-scratch-probe b=""
  m="$(findmnt -rno TARGET -S "$1" 2>/dev/null | head -n 1)"
  if [ -n "$m" ]; then
    df -B1 --output=avail "$m" 2>/dev/null | tail -n 1 | tr -d ' '
    return 0
  fi
  case "$2" in
    ext2|ext3|ext4) opts=ro,noload ;;
    xfs) opts=ro,norecovery ;;
    btrfs) opts=ro,rescue=nologreplay ;;
    *) opts=ro ;;
  esac
  mkdir -p "$dir"
  if mount -o "$opts" "$1" "$dir" >/dev/null 2>&1; then
    b="$(df -B1 --output=avail "$dir" 2>/dev/null | tail -n 1 | tr -d ' ')"
    umount "$dir" >/dev/null 2>&1 || umount -l "$dir" >/dev/null 2>&1
  fi
  rmdir "$dir" 2>/dev/null
  printf '%s' "$b"
}
# fs_name FS: a file system type as the boxes name it.
fs_name() {
  case "$1" in
    vfat) echo FAT ;; exfat) echo exFAT ;; ntfs) echo NTFS ;; xfs) echo XFS ;;
    *) echo "$1" ;;
  esac
}
pick_scratch() {
  local menu devs frees i n fs pk c dev t lbl sz fr
  # A stick plugged in just before Yes: give the system a moment to see it.
  sleep 2
  udevadm settle --timeout=10 >/dev/null 2>&1
  while true; do
    menu=(); devs=(); frees=(); i=1
    while read -r n fs pk; do
      [ -n "$fs" ] || continue
      case "$fs" in ext2|ext3|ext4|xfs|btrfs|ntfs|exfat|vfat) ;; *) continue ;; esac
      case "$pk" in "$TARGET"|/dev/nbd*|/dev/loop*|/dev/sr*|/dev/zram*|"") continue ;; esac
      # "/dev/sdb1  ext4, 16 GiB, 15,182 MB free": the free space in MB, as
      # the plan and the needed space are given (MB of 1,048,576 bytes, as
      # everywhere in the wizard and the shrink tool).
      sz="$(lsblk -bdno SIZE "$n" 2>/dev/null | tr -d ' ')"
      fr="$(part_free "$n" "$fs")"
      [ -n "$fr" ] && fr=$(( fr / 1048576 ))
      devs+=("$n"); frees+=("$fr"); menu+=("$i" "$n  $(fs_name "$fs")${sz:+, $(gib "$sz")}${fr:+, $(commas "$fr") MB free}$(case "$VENTOY_DISKS" in *" $pk "*) echo ', the restore stick' ;; esac)")
      i=$((i+1))
    done < <(lsblk -lnpo NAME,FSTYPE,PKNAME 2>/dev/null)
    if [ "${#devs[@]}" -eq 0 ]; then
      t="No USB stick or other disk with a usable partition was found yet.\n\nPlug it in, wait a few seconds, then choose Look again."
      mapfile -t lbl < <(yes_no_labels "Look again" "Stop")
      if dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - scratch space" "${lbl[@]}" \
         --yesno "$t" $(box_hw "$t"); then
        sleep 3
        udevadm settle --timeout=10 >/dev/null 2>&1
        continue
      fi
      no_scratch "No USB stick or other disk with a usable partition was found. The disk being restored onto (${TARGET}) cannot be used for this."
    fi
    t="Choose the partition to use for scratch space. It needs ${NEED_MB:+at least $(commas "$NEED_MB") MB }free space.\n\nA folder named pbs-shrink-scratch is made on it for the restore and removed afterwards. Nothing else on it is touched."
    dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - scratch space" \
    --menu "$t" $(menu_hw "$t" "${menu[@]}") \
    "${menu[@]}" $DIA_ESC 2> "$DIA_TMP"
    c="$(cat "$DIA_TMP")"
    [ -n "$c" ] || no_scratch ""
    dev="${devs[$((c-1))]}"
    mkdir -p /mnt/pbs-scratch
    [ -n "$SCRATCH_MNT" ] && umount "$SCRATCH_MNT" >/dev/null 2>&1
    SCRATCH_MNT=""
    if mount "$dev" /mnt/pbs-scratch >/tmp/pbs-scratch-mount.log 2>&1; then
      SCRATCH_MNT=/mnt/pbs-scratch
      SCRATCH=/mnt/pbs-scratch/pbs-shrink-scratch
      SCRATCH_DEV="$dev"
      SCRATCH_FREE_MB="${frees[$((c-1))]}"
      return 0
    fi
    t="${dev} could not be opened (mounted), so it cannot be used for scratch space. The system said:\n\n$(tail -n 2 /tmp/pbs-scratch-mount.log | cut -c1-150)\n\nNothing has been written to it, or to ${TARGET}.\n\nYou can:\n\na) Choose another partition, or plug in another USB stick and choose it.\n\nb) Use a stick formatted as exFAT, NTFS or ext4. An NTFS disk from a Windows computer that was not shut down fully (Fast Startup or hibernation) cannot be used until Windows is shut down fully.\n\nPress OK to choose again."
    plan_msg "$TITLE - scratch space" "$t"
    udevadm settle --timeout=10 >/dev/null 2>&1
  done
}

if [ -n "$SRC_BYTES" ] && [ -n "$TGT_BYTES" ] && [ "$SRC_BYTES" -gt "$TGT_BYTES" ]; then
  echo "Target ${TARGET} (${TGT_BYTES} bytes) is smaller than the backed up disk ${NBDDEV} (${SRC_BYTES} bytes): checking whether the data fits"
  PASS=1
  while true; do
    # The first pass reads the backup; after scratch space is chosen the tool
    # takes the rest from its check cache, so only the scratch space is new.
    if [ "$PASS" = "1" ]; then
      T="The new disk ${TARGET} ($(gib "$TGT_BYTES")) is smaller than the backed up disk ($(gib "$SRC_BYTES")).\n\nChecking whether the data fits on it. This reads the backup and takes about a minute. Nothing is written yet."
    else
      # The free space the scratch space menu showed for it, so the two agree.
      T="Checking the scratch space on ${SCRATCH_DEV:-the chosen partition}${SCRATCH_FREE_MB:+ ($(commas "$SCRATCH_FREE_MB") MB free)} ..."
    fi
    PASS=$((PASS + 1))
    dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - smaller disk" \
    --infobox "$T" $(box_hw "$T")
    PLAN="$(PBS_SHRINK_COLS="$PLAN_COLS" "$SHRINK_TOOL" -n -k "$SHRINK_ID" -c "$SCRATCH" "$NBDDEV" "$TARGET" 2>&1)"
    PRC=$?
    echo "$PLAN" >> "${ocs_log_dir}/pbs-shrink-plan.log"
    # The scratch space needed, from the tool's last line when it is short.
    NEED_MB="$(sed -n 's/^SCRATCH_NEED_MB=\([0-9]*\)$/\1/p' <<<"$PLAN" | tail -n 1)"
    # The table's Type column: an NTFS partition means a Windows backup.
    grep -qiE '^[0-9]+ +ntfs ' <<<"$PLAN" && OSNAME="Windows"
    # For the dialogs: the tool's own "plan only" and SCRATCH_NEED_MB lines
    # and its STOP prefix go.
    PLAN="$(sed -e '/^Plan only/d' -e '/^SCRATCH_NEED_MB=/d' -e 's/^STOP: //' <<<"$PLAN")"
    [ "$PRC" = "3" ] || break
    T="The new disk is smaller than the backed up disk. The data fits, but some of it must be moved while a partition shrinks.\n\n${PLAN}"
    Q="Do you have a suitable volume with at least $(commas "${NEED_MB:-0}") MB available to use as temporary scratch space? If so, please insert it now if required and select Yes."
    plan_ask "$TITLE - scratch space needed" "$T" "$Q" || no_scratch ""
    pick_scratch
  done
  if [ "$PRC" != "0" ]; then
    T="This backup cannot be restored onto the $(gib "$TGT_BYTES") disk ${TARGET}, which is smaller than the backed up disk ($(gib "$SRC_BYTES")):\n\n${PLAN}\n\n${SEP}\nNothing has been written to ${TARGET}.\n\nWhat you can do instead:\n\na) Restore onto a disk of at least $(gib "$SRC_BYTES"), the size of the backed up disk. That needs no shrinking.\n\nb) Install ${OSNAME} and the Salvanza backup client on this disk, then use the app's Restore page to open the disk image from this backup and restore your folders and files from it. Programs must be reinstalled, and the disk and ${OSNAME} get new identities.\n\nThe full check is in ${ocs_log_dir}/pbs-shrink-plan.log.\n\nPress OK to stop. The backup itself is not changed."
    plan_msg "$TITLE - cannot use this disk" "$T"
    stopped
  fi
  SHRINK=1
fi

# 9. confirmation before the destructive write: shows source+target+sizes.
# Deliberately just the one dialog here, not also a typed device-name
# step -- ocs-onthefly itself (below, no -batch) still asks its own two
# separate "y" confirmations before actually wiping the destination, so a
# third, slower, typed confirmation on top of that was redundant friction
# rather than real extra safety. Mick's call, 2026-09-24, after the first
# real timed run: this was the slowest manual step other than the
# mandatory PBS server details.
if [ "$SHRINK" = "1" ]; then
  # The plan is the confirmation: Clonezilla, and its own two questions, are
  # not used for a restore that shrinks.
  T="The new disk is smaller than the backed up disk, but the data fits. This is the plan:\n\n${PLAN}"
  Q="The backup on the server is only read, never changed. EVERYTHING on ${TARGET} ($(gib "$TGT_BYTES")) will be PERMANENTLY OVERWRITTEN.\n\nStart the restore?"
  plan_ask "$TITLE - confirm (smaller disk)" "$T" "$Q"
else
dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - confirm" \
--yesno "Restore from : ${KEY_NAME}, backup of ${DT_NAME}  (${SRC_SIZE:-unknown size})\nRestore onto : ${TARGET}  (${TGT_SIZE:-unknown size}), a disk in this computer${NOT_ELIGIBLE_BLOCK}\n\nEVERYTHING on ${TARGET} will be PERMANENTLY OVERWRITTEN. The backup on the server is only read, never changed.\n\nClonezilla then asks you to confirm twice more before it writes anything.\n\nStart the restore?" 0 0
fi
[ "$?" = "0" ] || stopped

# 10. run the restore directly -- skips Clonezilla's own generic
# device-image/device-device/beginner-mode wizard tree entirely.
#   -icds    ignore destination-disk-size check (target may not be an exact
#            size match, e.g. replacement hardware with a slightly larger disk)
#   -k0      use the partition table from the source image (default, explicit)
#   -sfsck   skip checking/repairing the source filesystem
#   -j2      also write back the data between the MBR and the first partition.
#            On a BIOS/MBR disk that is where GRUB keeps its core image, so
#            without it the restored disk stops at a bare "GRUB" prompt.
#            ocs-onthefly always saves it but only restores it when asked.
#   -irhr    keep the restored Linux system's identity. Without it Clonezilla
#            (made for cloning one machine to many) gives the restored system
#            a new /etc/machine-id and removes its udev hardware records. A
#            bare-metal restore brings back the same machine: with a new
#            machine-id, systemd-networkd sends another DHCP client ID (so the
#            machine can get another address) and the journal starts afresh.
#            Found 2026-10-21 restoring a Debian 13 machine. The initramfs
#            update (no -iui) stays: it helps when the restored disk is in
#            different hardware, and only rebuilds it from the restored system.
# No -p (postaction) here deliberately: this is the zero-choice BMR flow, so
# the power-off itself is handled explicitly below with our own message,
# instead of ocs-onthefly's own generic "-p choose" prompt (which is right
# for the manual ocs-pbs-nbd path, where an operator is already driving
# Clonezilla's menus, but wrong here).
# A Linux machine backup took its block snapshot with a copy-on-write store
# (/.pbs_snapshot_N.cow) on each snapshotted file system. Its blocks are left
# out of the image (zeros), but the file itself is still there, a tenth of
# the file system's size: remove it from the restored partitions.
remove_snapshot_stores() {
  local part mnt
  mnt="$(mktemp -d)"
  partprobe "$TARGET" >/dev/null 2>&1
  udevadm settle --timeout=10 >/dev/null 2>&1
  for part in $(lsblk -lnpo NAME,TYPE "$TARGET" 2>/dev/null | awk '$2=="part"{print $1}'); do
    case "$(blkid -o value -s TYPE "$part" 2>/dev/null)" in
      ext2|ext3|ext4|xfs) ;;
      *) continue ;;
    esac
    if mount "$part" "$mnt" >/dev/null 2>&1; then
      for f in "$mnt"/.pbs_snapshot_*.cow; do
        [ -f "$f" ] && rm -f "$f" && echo "  removed the backup's snapshot store $(basename "$f") from $part"
      done
      umount "$mnt" >/dev/null 2>&1
    fi
  done
  rmdir "$mnt" 2>/dev/null
}

# The restore itself starts here: from now on an exit leaves the image
# attached, as before (the next run's start lets go of it).
RELEASE_ON_EXIT=0
if [ "$SHRINK" = "1" ]; then
  # Blue boxes only from here: nothing on the terminal behind them.
  echo "> Starting restore (smaller disk): ${NBDDEV} -> ${TARGET} ..." >> "${ocs_log_dir}/pbs-shrink-plan.log"
  clear
  # On the terminal itself, not through tee: with -b the tool shows each step
  # in a blue box, the shrink as a gauge and each copy in partclone's progress
  # screen, as a normal restore does. Its record is
  # /tmp/pbs-shrink-logs/run.log, copied to the log folder.
  mkdir -p /tmp/pbs-shrink-logs
  DIA="$DIA" "$SHRINK_TOOL" -y -b -k "$SHRINK_ID" -c "$SCRATCH" "$NBDDEV" "$TARGET" 2>>/tmp/pbs-shrink-logs/stderr.log
  RC=$?
  rm -f "$SHRINK_CACHE"
  # A box over the tool's last one while the scratch space and the restored
  # partitions are tidied (a few seconds), so the screen never goes blank. It
  # names only what is done: scratch space when a partition was used for it,
  # the restored partitions when the restore finished.
  if [ -n "$SCRATCH_MNT" ] && [ "$RC" = "0" ]; then
    T="Finishing: tidying up the scratch space and the restored partitions ..."
  elif [ -n "$SCRATCH_MNT" ]; then
    T="Tidying up the scratch space and saving the logs ..."
  elif [ "$RC" = "0" ]; then
    T="Finishing: tidying up the restored partitions ..."
  else
    T="Saving the logs ..."
  fi
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - smaller disk" \
  --infobox "$T" $(box_hw "$T")
  cp -a /tmp/pbs-shrink-logs "${ocs_log_dir}/" 2>/dev/null
  if [ -n "$SCRATCH_MNT" ]; then
    rm -rf "$SCRATCH"
    umount "$SCRATCH_MNT" >/dev/null 2>&1
  fi
else
  echo "> Starting restore: ${NBDDEV} -> ${TARGET} ..."
  ocs-onthefly -icds -k0 -sfsck -j2 -irhr -f "$NBDDEV" -d "$TARGET"
  RC=$?
fi
[ "$RC" = "0" ] && remove_snapshot_stores
if [ "$RC" != "0" ] && [ "$SHRINK" = "1" ]; then
  T="The restore onto the smaller disk did not finish. The last lines of its log:\n\n$(tail -n 8 /tmp/pbs-shrink-logs/run.log 2>/dev/null | sed 's/^STOP: //' | cut -c1-150)\n\n${SEP}\n${TARGET} may be partly written and will probably not start. Do not use it until a restore has finished. The backup on the server was only read and has not changed.\n\nWhat you can do:\n\na) Start the restore again. If it stops at the same step, the logs say why.\n\nb) Restore onto a disk of at least $(gib "$SRC_BYTES"), the size of the backed up disk. That needs no shrinking.\n\nThe logs are in ${ocs_log_dir}/pbs-shrink-logs (run.log first). Exit code: $RC.\n\nPress OK to continue."
  plan_msg "$TITLE - restore failed" "$T"
elif [ "$RC" != "0" ]; then
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - restore failed" \
  --msgbox "The restore did not finish (Clonezilla stopped with exit code $RC).\n\nIf you answered no to one of Clonezilla's questions, nothing has been written. Otherwise ${TARGET} may be partly written: do not use it until a restore has finished. The backup on the server was only read and has not changed.\n\nStart the restore again. If it fails again, the logs in ${ocs_log_dir} say why.\n\nPress OK to continue." 0 0 $DIA_ESC
else
  # Power off rather than reboot: started from a USB stick there is no
  # "remove the medium" prompt (live-boot only gives one for a disc), so a
  # reboot started the stick, and this wizard, again (seen 2026-10-21). The
  # stick cannot be pulled before the reboot either, as the live system runs
  # from it. Off, the stick comes out safely and the next start is the
  # restored disk.
  dia --backtitle "$msg_nchc_free_software_labs" --title "$TITLE - complete" \
  --msgbox "The restore is complete.\n\nPress OK to switch the computer off. Then remove the restore stick or disc and switch the computer on again: it starts from the restored disk ${TARGET}.\n\nIf it starts this restore system again, choose the restored disk in the firmware's boot menu." 0 0 $DIA_ESC
  poweroff
fi

exit "$RC"
